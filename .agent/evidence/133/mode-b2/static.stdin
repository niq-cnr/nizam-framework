import ast,gzip,hashlib,json,subprocess
from pathlib import Path
root=Path.cwd(); base='84a1e19afeffdcaba5facfb7c28aa8cb0b14f4d7'; product='6d9556402eb7d3321de77be4572b85931573180e'; sha=lambda b:hashlib.sha256(b).hexdigest()
old=ast.parse(subprocess.check_output(['git','show',base+':tools/workflow_assurance.py'])); new=ast.parse((root/'tools/workflow_assurance.py').read_bytes()); compile(new,'product-static-only','exec')
for tree in (old,new): next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='_receipt_candidate').body=[]
assert ast.dump(old,include_attributes=False)==ast.dump(new,include_attributes=False)
expected={'tools/workflow_assurance.py':'5f5e15df384e9ef41e934f644b7a218717be680ed1cec99f68c6129e1072ee9d','tools/test_receipt_candidate_batching.py':'b6ca0247e3392b445fa3ae81e52b871bf39afc6e1f360dc77913a8d7eac3e024','tools/fixtures_self_test.sh':'098641d301c50cfa2815cffc3d49380e6a6c398b29e860e67713edc76dcb338e','.agent/contracts/133.json':'af3dce10147b7cc79af35ca02f681cf896d2a0821b2a219a9e703e5e7d308899','.agent/validator/133-mode-b.json':'62eaad69b6bf10dbd5fa57070e5fa0ad924af9fbc8e1a3b9674c77a15ea023c5'}
assert all(sha((root/p).read_bytes())==h for p,h in expected.items())
assert not subprocess.check_output(['git','diff',base,product,'--','.nizam','.github','tools/test_workflow_assurance.py','tools/test_receipt_candidate_batching.py','tools/fixtures_self_test.sh','.agent/contracts/133.json'])
index=root/'.agent/evidence/133/implementation2/capture-index.sha256'; rows=index.read_text().splitlines(); assert len(rows)==30
for line in rows:
 digest,name=line.split('  ',1); assert sha((index.parent/name).read_bytes())==digest
for i in range(1,5):
 frame=json.loads((index.parent/f'check-{i}.execution.json').read_text()); assert frame['actual_exit']==0 and frame['exercised_revision']==product and not frame['timed_out']
 before=gzip.decompress((index.parent/f'check-{i}.preservation-before.json.gz').read_bytes()); after=gzip.decompress((index.parent/f'check-{i}.preservation-after.json.gz').read_bytes()); assert before==after
 inventory=json.loads(before); assert len(inventory['rows'])==14517 and sum(row['path'].startswith('.nizam/') for row in inventory['rows'])==239
for p in (root/'.agent/evidence/133/mode-b1').iterdir():
 assert p.read_bytes()==subprocess.check_output(['git','show','f05f1b40fe23d457589302fadbb84eaa06ab6d39:'+str(p.relative_to(root))])
p=subprocess.Popen(['git','diff','--check',base,product],stdout=subprocess.PIPE,stderr=subprocess.PIPE); o,e=p.communicate(); assert p.returncode==0
print(json.dumps(dict(static_only=True,product_imported=False,acceptance_executed=False,masked_entire_module_ast_identical=True,frozen_hashes_and_prior_rejection_match=True,prior_raw_preserved=True,index_files=30,retained_focused_actual_exits=0,each_full_inventory_rows=14517,each_installed_rows=239,all_preservation_equal=True,diff_check_pid=p.pid,diff_check_actual_exit=p.returncode),sort_keys=True))
