 for schema in ('schema/frontmatter.schema.json','.nizam/schema/frontmatter.schema.json'):jsonschema.Draft202012Validator(json.loads((root/schema).read_text())).validate(bm)
 marker='## Historical snapshot'
 if marker in a:assert a[a.index(marker):]==b[b.index(marker):]
 for target in re.findall(r'\]\(([^)]+)\)',b.split(marker,1)[0]):
  if '://' not in target:
   target=target.split('#',1)[0]
   if target:assert (root/p).parent.joinpath(target).exists()
f=json.loads((root/paths[2]).read_bytes());a=json.loads(old(paths[2]));assert f.pop('spec_version')=='0.1.3';a.pop('spec_version');assert f==a
