assert scope['frozen_budget']==1493 and scope['authored_snapshot_overlay']==1299 and scope['snapshot_total']==1493+1299==2792;assert scope['actual_conservative']==max(scope['snapshot_total'],scope['authored_chronological_total'])==3024;assert scope['original_estimate']==2000 and scope['ceiling']==2600 and scope['budget_gate_passed'] is False and scope['first_feature_exception'] is True and scope['prior_completed_features']==[];assert scope['legacy018_post_endpoint_authored_snapshot']==scope['legacy018_post_endpoint_authored_chronological']==916
state=json.loads((root/'.agent/run_state.json').read_bytes());budget=state['scope_budget'];row=budget['per_feature'][0];assert budget['total_lines_changed']==3024 and budget['budget_gate_passed'] is False and budget['delivery_exception']['budget_gate_passed'] is False;assert row['source_lines']==83 and row['independent_test_lines']==331 and row['product_lines']==83+331==414 and row['process_overhead_lines']==2610 and 414+2610==3024;assert row['category_estimates_unchanged']['process']==1400 and 3024-2600==424;assert state['phase_018_scope_budget_final']==json.loads(old('.agent/run_state.json'))['phase_018_scope_budget_final']
mainpath='.agent/evidence/123/main-terminal1/report2.json';mainbytes=(root/mainpath).read_bytes();main=json.loads(mainbytes);assert sha(mainbytes)=='d671371dc09f5abbe8f541f7d01935a3b812f47feb5ec4d7b45f692602b14633';assert main['run_id']==38817712498 and main['head']=='c8ef3cd44dd795ae249769b79a99ef4ebf3f0ad7' and main['conclusion']=='success' and main['completed_at']=='2026-10-16T00:24:45Z'
for stem in ('terminal-run','terminal-jobs'):
 p=root/'.agent/evidence/123/main-terminal1'/stem;data=p.with_suffix('.stdout.txt').read_bytes();frame=json.loads(p.with_suffix('.execution.json').read_bytes());assert frame['actual_exit']==0 and sha(data)==frame['stdout']['sha256'];value=json.loads(data)
 if stem=='terminal-run':assert value['id']==38817712498 and value['head_sha']==main['head'] and value['status']=='completed' and value['conclusion']=='success'
 else:assert len(value['jobs'])==5 and all(j['status']=='completed' and j['conclusion']=='success' for j in value['jobs']) and max(j['completed_at'] for j in value['jobs'])==main['completed_at']
