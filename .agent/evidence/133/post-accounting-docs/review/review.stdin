import hashlib,json,re,subprocess,yaml,jsonschema
from pathlib import Path
root=Path.cwd();base='546fe8ed4be054e4eaf45667134f81bfa8273eb4';revision='06070c9d459968971694b2155a1ad6b716d25a5d';sha=lambda b:hashlib.sha256(b).hexdigest();paths=['.agent/product_spec_021.md','.agent/product_spec_018.md','.agent/feature_list_021.json','docs/planning/ROADMAP.md','docs/planning/HANDOVER.md','docs/planning/DEBT.md']
assert set(subprocess.check_output(['git','diff','--name-only',base,'HEAD']).decode().splitlines())==set(paths)
def old(p):return subprocess.check_output(['git','show',base+':'+p])
for p in paths:
 if not p.endswith('.md'):continue
