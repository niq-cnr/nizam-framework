workflow=yaml.safe_load(git('show',HEAD+':.github/workflows/compliance.yml')); association_provenance=[]
ansi=re.compile(r'\x1b\[[0-?]*[ -/]*[@-~]')
def payloads_for(job,step_name):
 metadata_steps=[s for j in jobs if j['name']==job for s in j['steps'] if s['name']==step_name]
 assert len(metadata_steps)==1; metadata=metadata_steps[0]; assert metadata['status']=='completed' and metadata['conclusion']=='success'
 named=[r for r in rows if r[0]==job and r[1]==step_name]
 if named: return [r[2] for r in named]
 job_rows=[r for r in rows if r[0]==job]; assert {r[1] for r in job_rows}=={'UNKNOWN STEP'}
 source_step=next(s for s in workflow['jobs'][job]['steps'] if s.get('name', 'Run '+s.get('run','').strip())==step_name)
 command=source_step['run']; command_lines=command.splitlines()
 candidates=[i for i,r in enumerate(job_rows) if r[2]=='##[group]Run '+command_lines[0] and [ansi.sub('',q[2]) for q in job_rows[i+1:i+1+len(command_lines)]]==command_lines]
 assert len(candidates)==1; begin=candidates[0]
 end=next((i for i in range(begin+1,len(job_rows)) if job_rows[i][2].startswith('##[group]Run ')),len(job_rows)); block=job_rows[begin:end]
 start=datetime.fromisoformat(metadata['started_at'].replace('Z','+00:00')); stop=datetime.fromisoformat(metadata['completed_at'].replace('Z','+00:00'))+timedelta(seconds=1)
 assert start<stop and all(start<=r[3]<stop for r in block)
 association_provenance.append(dict(job=job,expected_step=step_name,raw_step_label='UNKNOWN STEP',workflow_command_sha256=sha(command.encode()),raw_line_start=block[0][4],raw_line_end=block[-1][4],command_group_start=block[0][3].isoformat(),next_command_group_start=job_rows[end][3].isoformat() if end<len(job_rows) else None,authoritative_step_number=metadata['number'],metadata_started_at=metadata['started_at'],metadata_completed_at=metadata['completed_at'],window='[started_at, completed_at+1second)',raw_labels_preserved=True))
 return [r[2] for r in block]
