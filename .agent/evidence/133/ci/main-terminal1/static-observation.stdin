rows=[]
for number,line in enumerate((O/'terminal-logs.stdout.txt').read_text().splitlines(),1):
 parts=line.split('\t',2); assert len(parts)==3; stamp,_,payload=parts[2].lstrip('\ufeff').partition(' ')
 rows.append((parts[0],parts[1],payload,datetime.fromisoformat(stamp.replace('Z','+00:00')),number))
