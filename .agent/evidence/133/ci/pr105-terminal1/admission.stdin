import ast,hashlib,json,subprocess
from pathlib import Path
import yaml
C=Path.cwd();R=Path('/home/cnross/.tmp/nizam-133-pr105-terminal1-evidence');O=Path('/home/cnross/.tmp/nizam-133-pr105-terminal1')
HEAD='441d292559eacb95c778b4e20bcc62350e9f31a8';BASE='c8ef3cd44dd795ae249769b79a99ef4ebf3f0ad7';CHECKOUT='0a830707aebee1773e0feeb107cc3b42ab9fca53';COLLECTOR='cc1a73c97f770573bd26239f6978c001341ac783';OWN='06056e9abc8290b58f47e3225f7413ac992c8d6c'
def sha(raw):return hashlib.sha256(raw).hexdigest()
def git(*argv):return subprocess.check_output(['git','-C',str(R),*argv])
def read(name):return json.loads((O/(name+'.stdout.txt')).read_bytes())
assert subprocess.check_output(['git','rev-parse','HEAD']).decode().strip()==COLLECTOR and subprocess.check_output(['git','status','--porcelain','--untracked-files=all'])==b''
run=read('terminal-run');container=read('terminal-jobs');jobs=container['jobs'];expected={'validate','e2e_bootstrap','fixtures_self_test','convergent_review','self_governance'}
assert run['id']==38831271485 and run['run_attempt']==1 and run['head_sha']==HEAD and run['event']=='pull_request' and run['status']=='completed' and run['conclusion']=='failure'
assert container['total_count']==len(jobs)==5 and {j['name'] for j in jobs}==expected and all(j['status']=='completed' and j['run_id']==run['id'] and j['head_sha']==HEAD for j in jobs)
failed={'fixtures_self_test','convergent_review'};assert {j['name'] for j in jobs if j['conclusion']=='failure'}==failed and all(j['conclusion']=='success' for j in jobs if j['name'] not in failed)
checks=read('terminal-checks');assert checks['headRefOid']==HEAD and checks['baseRefOid']==BASE and checks['state']=='OPEN' and not checks['isDraft']
rollup=checks['statusCheckRollup'];assert len(rollup)==6 and {v['name'] for v in rollup}==expected|{'closeout'} and all(v['status']=='COMPLETED' for v in rollup)
assert {v['name'] for v in rollup if v['conclusion']=='FAILURE'}==failed and all(v['conclusion']=='SUCCESS' for v in rollup if v['name'] not in failed)
feedback=read('terminal-feedback');assert not feedback.get('errors');pr=feedback['data']['repository']['pullRequest'];assert pr['headRefOid']==HEAD and pr['baseRefOid']==BASE
for key in ('reviews','comments','reviewThreads'):assert pr[key]['nodes']==[] and not pr[key]['pageInfo']['hasNextPage']
rows=[]
for line in (O/'terminal-logs.stdout.txt').read_text().splitlines():
 parts=line.split('\t',2);assert len(parts)==3;rows.append((parts[0],parts[1],parts[2].lstrip('\ufeff').partition(' ')[2]))
footers=[(j,s) for j,s,t in rows if t=='Cleaning up orphan processes'];assert len(footers)==5 and {j for j,s in footers}==expected
raw=(O/'checkout-commit.stdout.txt').read_bytes();assert hashlib.sha1(b'commit '+str(len(raw)).encode()+b'\0'+raw).hexdigest()==CHECKOUT
assert git('rev-parse','refs/wa133/pr105-merge').decode().strip()==CHECKOUT and git('show','-s','--format=%P',CHECKOUT).decode().strip().split()==[BASE,HEAD] and git('rev-parse',CHECKOUT+'^{tree}')==git('rev-parse',HEAD+'^{tree}')
pins={'tools/workflow_assurance.py':'5f5e15df384e9ef41e934f644b7a218717be680ed1cec99f68c6129e1072ee9d','tools/test_receipt_candidate_batching.py':'b6ca0247e3392b445fa3ae81e52b871bf39afc6e1f360dc77913a8d7eac3e024','tools/fixtures_self_test.sh':'098641d301c50cfa2815cffc3d49380e6a6c398b29e860e67713edc76dcb338e'}
for path,digest in pins.items():assert sha(git('show',CHECKOUT+':'+path))==digest
receipts=[(j,json.loads(t.split('=',1)[1])) for j,s,t in rows if s=='Record maintenance checkout source identity' and t.startswith('MAINTENANCE_CHECKOUT_RECEIPT={')];assert len(receipts)==2 and {j for j,r in receipts}==failed
workflow=yaml.safe_load(git('show',HEAD+':.github/workflows/compliance.yml'))
for job,receipt in receipts:
 step=next(s for s in workflow['jobs'][job]['steps'] if s.get('name')=='Record maintenance checkout source identity');lines=step['run'].splitlines();assert lines[0]=="python3 - <<'PY'" and lines[-1]=='PY'
 paths=ast.literal_eval(next(n.value for n in ast.parse('\n'.join(lines[1:-1])).body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='paths' for t in n.targets)))
 assert len(paths)==len(set(paths))==9 and receipt['checkout_sha']==CHECKOUT and set(receipt['source_sha256'])==set(paths)
 for path,digest in receipt['source_sha256'].items():assert sha(git('show',CHECKOUT+':'+path))==digest
helper=git('show',HEAD+':.agent/evidence/123/fresh-qa1/finalize2.py');assert sha(helper)=='55128e72b14e620f7b35b8e0d68293af39c53236d61de4c88eb1cf469fda1872'
function=next(n for n in ast.parse(helper).body if isinstance(n,ast.FunctionDef) and n.name=='inventory_ast');scope={'ast':ast};exec(compile(ast.Module(body=[function],type_ignores=[]),'immutable AST inventory','exec'),scope)
cases=scope['inventory_ast'](git('show',HEAD+':tools/test_workflow_assurance.py'));assert len(cases)==len(set(cases))==48
runner=ast.parse(git('show',HEAD+':tools/test_receipt_candidate_batching.py'));assignments={t.id:n.value for n in runner.body if isinstance(n,ast.Assign) for t in n.targets if isinstance(t,ast.Name)};new_checks=list(ast.literal_eval(assignments['CHECKS']));assert len(new_checks)==4
error='ASSERTION_FAILURE: product AST outside _receipt_candidate body changed';failure_rows=[]
for job,step in [('fixtures_self_test','Run bash tools/fixtures_self_test.sh'),('convergent_review','Run fixture self-test')]:
 payloads=[t for j,s,t in rows if j==job and s==step]
 assert payloads.count(error)==1 and payloads.count('FAIL receipt-candidate-batching focused checks')==1 and payloads.count('SELF-TEST FAILED: 166/166 fixtures accounted for (see FAIL lines above)')==1
 for case in ('ci-candidate-bound','ci-blocker-rejected'):assert payloads.count('OK   workflow-assurance '+case)==1
 assert not any(t=='PASS '+name for name in new_checks for t in payloads)
 assert sum(j==job and t=='Successfully set up CPython (3.14.8)' for j,s,t in rows)==1
 failure_rows.append(dict(job=job,step=step,diagnostic=error,accounted_fixture_files='166/166',new_named_passes=0))
fixture=next(j for j in jobs if j['name']=='fixtures_self_test');assert next(s for s in fixture['steps'] if s['name']=='Run PYTHONDONTWRITEBYTECODE=1 python3 tools/test_workflow_assurance.py')['conclusion']=='skipped'
assert not any(j=='fixtures_self_test' and s=='Run PYTHONDONTWRITEBYTECODE=1 python3 tools/test_workflow_assurance.py' and t.startswith('PASS ') for j,s,t in rows)
frames=[]
for path in sorted(O.glob('*.execution.json')):
 f=json.loads(path.read_bytes());expected_exit=1 if path.name=='watch.execution.json' else 0;assert f['actual_exit']==expected_exit and not f['timed_out'] and f['exercised_revision']==(OWN if path.name in ('fetch-merge.execution.json','checkout-commit.execution.json') else COLLECTOR)
 for stream in ('stdout','stderr'):
  ref=f[stream];raw=Path(ref['path']).read_bytes();assert sha(raw)==ref['sha256'] and len(raw)==ref['bytes']
 frames.append(dict(path=path.name,actual_exit=expected_exit))
local=json.loads(git('show',HEAD+':.agent/evidence/133/qa1/check-1.execution.json'))['environment']['runtime']['version']
report=dict(pr_number=105,root_release=OWN,run_id=run['id'],run_attempt=1,head=HEAD,base=BASE,workflow_conclusion='failure',terminal_at=run['updated_at'],jobs={j['name']:dict(id=j['id'],conclusion=j['conclusion']) for j in jobs},required_checks={c['name']:c['conclusion'] for c in rollup},failure_evidence=failure_rows,coverage=dict(expected_default_cases=48,actual_separate_default48='skipped',expected_new_checks=new_checks,actual_new_check_passes_per_shell_job=0,fixture_file_accounting_per_shell_job='166/166 accounted; suite failed'),actual_checkout=CHECKOUT,checkout_tree=git('rev-parse',CHECKOUT+'^{tree}').decode().strip(),checkout_parents=[BASE,HEAD],checkout_commit_bytes_retained='checkout-commit.stdout.txt',immutable_checkout_pins=pins,physical_source9_hashes=receipts[0][1]['source_sha256'],pin_scope='Two physical receipts cover their explicit nine paths; API and runner hashes bind immutable checkout Git blobs.',collector_revision=COLLECTOR,own_evidence_context=OWN,feedback_clear=True,feedback_pagination_complete=True,runtime=dict(hosted_python='3.14.8',retained_local_qa_python=local,frozen_masked_ast_sha256=ast.literal_eval(assignments['MASKED_AST'])),diagnostic_inference='A runtime-dependent AST representation is a likely frozen-test portability defect; exact causal normalization still requires independent diagnosis. No repair or alternate runtime execution performed here.',qualified_log=dict(path='terminal-logs.stdout.txt',bytes=(O/'terminal-logs.stdout.txt').stat().st_size,sha256=sha((O/'terminal-logs.stdout.txt').read_bytes()),lines=len(rows),observed_cleanup_footer_labels=dict(footers),collector_cli_sha256='5eb17f67b155d2595267b6aa8c030ca8def95c6f4fb4216570708b44eef06075'),verified_frames=frames,final_verdict=dict(approved=False,summary='PR105 is blocked by two required CI job failures at the frozen runner AST guard; no merge authorization inferred.'),issues=['Both capable shell jobs failed the new static AST guard under hosted CPython3.14.8.'],missing_acceptance_coverage=['Separate ordered default48 plus auxiliary did not run after shell failure.','None of the new four named checks completed in either capable shell job.'],unsupported_claims=[],scope='Read-only terminal triage. Original workflow/watch failure and complete logs retained; no CI rerun, Source/test/state edit, historical proof rebinding or integration-success claim.')
p=O/'report.json';assert not p.exists();p.write_text(json.dumps(report,indent=2)+'\n');print(json.dumps(dict(strict_approved=False,workflow='failure',failed_jobs=2,required_successful_checks=4,source_bound=True,logs_complete=True)))
