import ast, hashlib, json, subprocess
from pathlib import Path
root=Path.cwd()
runner=root/'tools/test_receipt_candidate_batching.py'
tree=ast.parse(runner.read_bytes()); compile(tree,str(runner),'exec')
product=ast.parse((root/'tools/workflow_assurance.py').read_bytes())
next(n for n in product.body if isinstance(n,ast.FunctionDef) and n.name=='_receipt_candidate').body=[]
expected=next(n.value.value for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='MASKED_AST' for t in n.targets))
assert hashlib.sha256(ast.dump(product,include_attributes=False).encode()).hexdigest()==expected
print('STATIC_AST_COMPILE_AND_UNCHANGED_PRODUCT_MASK PASS',flush=True)
for argv in (['bash','-n','tools/fixtures_self_test.sh'],['git','diff','--check']):
    process=subprocess.Popen(argv,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    stdout,stderr=process.communicate()
    print(json.dumps(dict(argv=argv,pid=process.pid,actual_exit=process.returncode,stdout=stdout.decode(),stderr=stderr.decode()),sort_keys=True),flush=True)
    assert process.returncode==0
for path,expected in [('tools/workflow_assurance.py','2579b0d94598621acccc6e257408e80a0657834393a6f30be878da94967e70b8'),('tools/test_workflow_assurance.py','06eba273dbfd615df7f0ea3b6b52592ed208f9ec267b52a1e06996488b850f13')]:
    assert hashlib.sha256((root/path).read_bytes()).hexdigest()==expected
print('STATIC_ONLY_NO_PRODUCT_IMPORT_OR_BEHAVIOR PASS',flush=True)
