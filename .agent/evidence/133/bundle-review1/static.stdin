import ast, hashlib, json, subprocess
from pathlib import Path
root=Path.cwd(); sha=lambda raw:hashlib.sha256(raw).hexdigest()
expected={'tools/test_receipt_candidate_batching.py':'b6ca0247e3392b445fa3ae81e52b871bf39afc6e1f360dc77913a8d7eac3e024','tools/fixtures_self_test.sh':'098641d301c50cfa2815cffc3d49380e6a6c398b29e860e67713edc76dcb338e','tools/workflow_assurance.py':'2579b0d94598621acccc6e257408e80a0657834393a6f30be878da94967e70b8','tools/test_workflow_assurance.py':'06eba273dbfd615df7f0ea3b6b52592ed208f9ec267b52a1e06996488b850f13','.agent/contracts/133.json':'af3dce10147b7cc79af35ca02f681cf896d2a0821b2a219a9e703e5e7d308899','.agent/evidence/133/tests-authoring1/freeze.json':'2f89be740dab2307b3fd73500597e229ef17d104568d08a9a1600083a996bd67'}
assert all(sha((root/p).read_bytes())==h for p,h in expected.items())
runner=ast.parse((root/'tools/test_receipt_candidate_batching.py').read_bytes()); compile(runner,'runner-static-only','exec')
constants={n.targets[0].id:ast.literal_eval(n.value) for n in runner.body if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name)}
assert constants['CHECKS']==('real-git-count-reduction','semantic-equivalence','fresh-mutations','literal-paths-and-modes')
product=ast.parse((root/'tools/workflow_assurance.py').read_bytes()); next(n for n in product.body if isinstance(n,ast.FunctionDef) and n.name=='_receipt_candidate').body=[]
assert sha(ast.dump(product,include_attributes=False).encode())==constants['MASKED_AST']
for argv in (['bash','-n','tools/fixtures_self_test.sh'],['git','diff','--check','d139e1bb8ca0dee5a5373bfd5a5914988dfb2b0c','2f851cb8d75b7dfc6b614c7d2199aae28cc40478']):
 p=subprocess.Popen(argv,stdout=subprocess.PIPE,stderr=subprocess.PIPE); stdout,stderr=p.communicate(); print(json.dumps(dict(argv=argv,pid=p.pid,actual_exit=p.returncode,stdout=stdout.decode(),stderr=stderr.decode()),sort_keys=True)); assert p.returncode==0
tracked=subprocess.check_output(['git','ls-files','-z','--','.nizam']).split(b'\0')[:-1]
assert len(tracked)==239
assert all((root/p.decode()).read_bytes()==subprocess.check_output(['git','show','d139e1bb8ca0dee5a5373bfd5a5914988dfb2b0c:'+p.decode()]) for p in tracked)
assert not subprocess.check_output(['git','ls-files','--others','-z','--','.nizam'])
fixture_paths=subprocess.check_output(['git','ls-tree','-r','--name-only','-z','2f851cb8d75b7dfc6b614c7d2199aae28cc40478','--','tools/fixtures'])
assert fixture_paths==subprocess.check_output(['git','ls-tree','-r','--name-only','-z','d139e1bb8ca0dee5a5373bfd5a5914988dfb2b0c','--','tools/fixtures'])
print(json.dumps(dict(static_only=True,product_imported=False,acceptance_executed=False,all_six_hashes_match=True,whole_module_masked_ast_matches=True,installed_files=len(tracked),fixture_inventory_unchanged=True),sort_keys=True))
