import ast,hashlib,inspect,json,platform,sys
from pathlib import Path
root=Path.cwd();out=Path(sys.argv[1]);label=sys.argv[2];sha=lambda raw:hashlib.sha256(raw).hexdigest()
runner=root/'tools/test_receipt_candidate_batching.py';source=root/'tools/workflow_assurance.py';runner_raw=runner.read_bytes();source_raw=source.read_bytes()
assert sha(runner_raw)=='b6ca0247e3392b445fa3ae81e52b871bf39afc6e1f360dc77913a8d7eac3e024' and sha(source_raw)=='5f5e15df384e9ef41e934f644b7a218717be680ed1cec99f68c6129e1072ee9d'
assert sha((root/'tools/fixtures_self_test.sh').read_bytes())=='098641d301c50cfa2815cffc3d49380e6a6c398b29e860e67713edc76dcb338e'
r=ast.parse(runner_raw);expected=next(ast.literal_eval(n.value) for n in r.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='MASKED_AST' for t in n.targets));main=next(n for n in r.body if isinstance(n,ast.FunctionDef) and n.name=='main');attempt=next(n for n in main.body if isinstance(n,ast.Try));guard=attempt.body[:4];assert [type(n).__name__ for n in guard]==['Assign','Assign','Assign','Expr']
namespace=dict(ast=ast,Path=Path,hashlib=hashlib,__file__=str(runner),MASKED_AST=expected)
functions=[n for n in r.body if isinstance(n,ast.FunctionDef) and n.name in ('sha','require')];exec(compile(ast.Module(body=functions,type_ignores=[]),'unchanged-runner-functions','exec'),namespace)
product=ast.parse(source_raw);next(n for n in product.body if isinstance(n,ast.FunctionDef) and n.name=='_receipt_candidate').body=[]
def structure(value):
 if isinstance(value,ast.AST):return [type(value).__name__,[[key,structure(v)] for key,v in ast.iter_fields(value)]]
 if isinstance(value,list):return [structure(v) for v in value]
 return [type(value).__name__,repr(value)]
model=json.dumps(structure(product),ensure_ascii=False,separators=(',',':')).encode();(out/(label+'.fields.json')).write_bytes(model)
dump=ast.dump(product,include_attributes=False).encode();(out/(label+'.default.dump')).write_bytes(dump)
full=ast.dump(product,include_attributes=False,**({'show_empty':True} if 'show_empty' in inspect.signature(ast.dump).parameters else {})).encode();(out/(label+'.full.dump')).write_bytes(full)
sample=ast.parse('def f():'+chr(10)+'    return 1'+chr(10));summary=dict(version=sys.version,executable=sys.executable,executable_sha256=sha(Path(sys.executable).resolve().read_bytes()),implementation=platform.python_implementation(),ast_module=ast.__file__,ast_module_sha256=sha(Path(ast.__file__).read_bytes()),runner_sha256=sha(runner_raw),api_sha256=sha(source_raw),expected=expected,default_dump_sha256=sha(dump),full_dump_sha256=sha(full),fields_sha256=sha(model),node_count=sum(1 for n in ast.walk(product)),dump_signature=str(inspect.signature(ast.dump)),sample_default=ast.dump(sample,include_attributes=False),sample_full=ast.dump(sample,include_attributes=False,**({'show_empty':True} if 'show_empty' in inspect.signature(ast.dump).parameters else {})))
print(json.dumps(summary,sort_keys=True),flush=True)
try:
 exec(compile(ast.Module(body=guard,type_ignores=[]),'exact-frozen-main-guard','exec'),namespace)
except AssertionError as exc:
 print('ASSERTION_FAILURE: '+str(exc),file=sys.stderr);sys.exit(1)
print('EXACT_FROZEN_GUARD_PASS; no product import, Git fixture or selector executed',flush=True)
