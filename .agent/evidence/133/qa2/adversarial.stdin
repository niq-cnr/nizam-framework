"""One independent QA133 probe: real valid readset beyond host argv capacity."""
import json, os, subprocess, sys, tempfile
from pathlib import Path
from unittest.mock import patch
sys.path.insert(0, str(Path.cwd() / 'tools'))
import workflow_assurance as api

def require(value, message):
    if not value: raise AssertionError(message)

def git(root, *args):
    result = subprocess.run(['git', '-C', str(root), *args], capture_output=True)
    require(result.returncode == 0, 'fixture Git failure: ' + repr((args, result.returncode, result.stderr)))
    return result.stdout.decode().strip()

for key in list(os.environ):
    if key.startswith('GIT_'): os.environ.pop(key)
os.environ.update(GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_NOSYSTEM='1')
arg_max = os.sysconf('SC_ARG_MAX')
with tempfile.TemporaryDirectory(prefix='nizam133-large-valid-') as scratch:
    root = Path(scratch) / 'repo'; root.mkdir()
    git(root, 'init', '--quiet', '--object-format=sha1')
    for key, value in [('user.name', 'Independent QA133'), ('user.email', 'qa133@example.invalid'), ('commit.gpgsign', 'false'), ('core.autocrlf', 'false'), ('core.filemode', 'true'), ('gc.auto', '0')]:
        git(root, 'config', key, value)
    git(root, 'remote', 'add', 'origin', 'https://github.com/niq-cnr/nizam-framework.git')
    paths = []; total = 0
    while total <= arg_max + 65536:
        name = 'source/' + str(len(paths)).zfill(6) + '-' + 'x' * 200 + '.txt'
        paths.append(name); total += len(os.fsencode(name)) + 1
    special = ['zz/with space.txt', 'zz/tab\tname.txt', 'zz/new\nline.txt', 'zz/café.txt', 'zz/[*?].txt', '-leading.txt', ':(glob)*.txt', 'zz/' + 'z' * 220]
    paths += special
    inputs = dict(source=paths, tests=['tests/check.txt'], tools=['tools/check.sh'], contracts=['contracts/record.json'], unknown_dependencies=[])
    expected = {}
    for category in ('source', 'tests', 'tools', 'contracts'):
        for i, name in enumerate(inputs[category]):
            raw = b'{"fixed":1}\n' if category == 'contracts' else ('literal:' + name + '\n').encode()
            executable = bool(i % 2) if category != 'contracts' else False
            target = root / name; target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(raw); target.chmod(0o755 if executable else 0o644)
            expected[name] = (raw, executable)
    def commit(message, empty=False):
        git(root, 'add', '--all'); git(root, 'commit', '--quiet', *(['--allow-empty'] if empty else []), '-m', message)
        return git(root, 'rev-parse', 'HEAD')
    anchor = commit('independent large valid anchor')
    candidate = api.assess_repository(root, anchor, inputs, [], {})
    executed = commit('distinct executed revision', True)
    require(anchor != executed and total > arg_max + 65536, 'real boundary preconditions')
    for name in special:
        for revision in (anchor, executed):
            require(api._entry_blob(root, revision, name) == expected[name], 'independent literal/mode oracle differs')
    protected = set(paths + inputs['tests'] + inputs['tools'])
    def observe(label, rejection=None):
        revision = git(root, 'rev-parse', 'HEAD'); launches = []; original = subprocess.Popen
        def launch(*args, **kwargs):
            child = original(*args, **kwargs); launches.append((list(args[0] if args else kwargs['args']), child)); return child
        failure = None
        with patch.object(subprocess, 'Popen', launch):
            try:
                require(api._receipt_candidate(root, candidate) is None, 'successful return changed')
            except api.AssuranceError as exc: failure = str(exc)
        rows = [dict(argv=argv, pid=p.pid, actual_exit=p.returncode) for argv, p in launches]
        print('REAL_GIT_TRACE ' + json.dumps(dict(label=label, launches=rows), ensure_ascii=False), flush=True)
        require(rows and all(r['argv'][0] == 'git' and r['actual_exit'] == 0 for r in rows), 'actual successful Git processes required')
        seen = {anchor: [], revision: []}; chunks = {anchor: 0, revision: 0}
        for row in rows:
            argv = row['argv']
            if 'ls-tree' not in argv: continue
            pos = argv.index('ls-tree'); sep = argv.index('--', pos); ref = argv[sep - 1]
            require('--literal-pathspecs' in argv and ref in seen, 'literal committed read authority')
            seen[ref].extend(argv[sep + 1:]); chunks[ref] += 1
        for ref in seen:
            wanted = protected | (set(inputs['contracts']) if ref == anchor else set())
            require(len(seen[ref]) == len(set(seen[ref])) and set(seen[ref]) == wanted and chunks[ref] > 1, 'exact multi-chunk per-revision readset')
        require(failure is None if rejection is None else failure is not None and failure.startswith(rejection), 'wrong acceptance/rejection: ' + repr(failure))
        print('OBSERVATION ' + json.dumps(dict(label=label, revision=revision, rejection=failure, chunks=chunks)), flush=True)
    observe('valid-large-readset')
    late = sorted(paths)[-1]; raw, executable = expected[late]
    (root / late).write_bytes(raw + b'isolated committed late-chunk defect\n'); commit('late chunk defect')
    observe('late-chunk-rejected', 'receipt protected Git input changed')
    (root / late).write_bytes(raw); (root / late).chmod(0o755 if executable else 0o644); commit('restore late chunk')
    observe('restored-large-readset')
    print('PASS independent-large-valid-readset ' + json.dumps(dict(arg_max=arg_max, unbounded_path_argv_bytes=total, source_paths=len(paths), late_path=late, source_commit=anchor, original_executed_commit=executed)), flush=True)
