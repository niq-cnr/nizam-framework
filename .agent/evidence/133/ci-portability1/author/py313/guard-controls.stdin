"""Author development only: exact repaired CLI guard on private valid source copies."""
import ast, hashlib, json, platform, runpy, sys, tempfile
from pathlib import Path

root = Path.cwd(); out = Path(sys.argv[1])
original = (root / 'tools/workflow_assurance.py').read_bytes()
runner = (root / 'tools/test_receipt_candidate_batching.py').read_bytes()
sha = lambda raw: hashlib.sha256(raw).hexdigest()
assert sha(original) == '5f5e15df384e9ef41e934f644b7a218717be680ed1cec99f68c6129e1072ee9d'
assert sha(runner) == 'd4d2e4df39ffabc24135d414e478c417bfab28a8914aaa6d91a90fe0ebb0bc44'
driver = root / '.agent/evidence/123/fresh-qa-capture1.py'
assert sha(driver.read_bytes()) == 'e9e9417c39548919b892f0b7436b885b72a26b781d15455e62daebe9367c5ac0'
execute = runpy.run_path(str(driver))['execute']
tree = ast.parse(original)

def insert_pass(name):
    target = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == name)
    lines = original.decode().splitlines(keepends=True)
    first = target.body[0]
    lines.insert(first.lineno - 1, ' ' * first.col_offset + 'pass\n')
    return ''.join(lines).encode()

signature = b'def _receipt_candidate(root, candidate, revision=None):'
assert original.count(signature) == 1
variants = [
    ('global-added', original + b'\nPORTABILITY_SCOPE_NEGATIVE = 1\n', 1),
    ('helper-pass', insert_pass('_entry_blob'), 1),
    ('signature-added', original.replace(signature, b'def _receipt_candidate(root, candidate, revision=None, unexpected=None):'), 1),
    ('body-pass', insert_pass('_receipt_candidate'), 0),
]
for name, raw, expected in variants:
    compile(raw, name + '.py', 'exec')  # Every negative is valid Python, never setup-as-red.
    with tempfile.TemporaryDirectory(prefix='nizam133-portability-' + name + '-') as scratch:
        private = Path(scratch)
        private_api = private / 'workflow_assurance.py'
        private_runner = private / 'test_receipt_candidate_batching.py'
        private_api.write_bytes(raw); private_runner.write_bytes(runner)
        result = execute(root, out, name, [sys.executable, str(private_runner), '--check', 'real-git-count-reduction'], 1200)
        assert result['actual_exit'] == expected and not result['timed_out'], (name, result)
        stdout = Path(result['stdout']['path']).read_bytes()
        stderr = Path(result['stderr']['path']).read_bytes()
        if expected:
            assert stdout == b'' and stderr == b'ASSERTION_FAILURE: product AST outside _receipt_candidate body changed\n', name
        else:
            assert stderr == b'' and stdout.splitlines()[-1] == b'PASS real-git-count-reduction', name
        assert private_api.read_bytes() == raw and private_runner.read_bytes() == runner
        print('GUARD_CONTROL ' + json.dumps(dict(name=name, expected_exit=expected, actual_exit=result['actual_exit'], private_source_sha256=sha(raw), runner_sha256=sha(runner), python=platform.python_version(), executable=sys.executable, execution=name + '.execution.json', private_scope='Owned temporary source copy; carrier checkout remains candidate7f080b16.')), flush=True)
