import ast, gzip, hashlib, json, subprocess
from pathlib import Path
root = Path.cwd()
base = '441d292559eacb95c778b4e20bcc62350e9f31a8'
candidate = '7f080b16af45c72a852f77acce387c87961e6586'
evidence = 'c07dc7d6eeedcec8bae5e098e8e13954891e7e38'
sha = lambda raw: hashlib.sha256(raw).hexdigest()
def git(*args): return subprocess.check_output(['git', *args])
runner = 'tools/test_receipt_candidate_batching.py'
old, new = (git('show', rev + ':' + runner) for rev in (base,candidate))
assert git('diff', '--name-only', base, candidate).decode().splitlines() == [runner]
assert new == (root/runner).read_bytes()
original = b"        require(sha(ast.dump(tree, include_attributes=False).encode()) == MASKED_AST, 'product AST outside _receipt_candidate body changed')"
replacement = b"        dump_options = {'show_empty': True} if sys.version_info >= (3, 13) else {}\n        require(sha(ast.dump(tree, include_attributes=False, **dump_options).encode()) == MASKED_AST, 'product AST outside _receipt_candidate body changed')"
assert old.count(original) == 1 and new == old.replace(original,replacement)
assert sha(new) == 'd4d2e4df39ffabc24135d414e478c417bfab28a8914aaa6d91a90fe0ebb0bc44'
assert git('diff','--name-only',candidate,evidence).decode().splitlines() and all(p.startswith('.agent/evidence/133/ci-portability1/author/') for p in git('diff','--name-only',candidate,evidence).decode().splitlines())
compile(new,runner,'exec')
author = root/'.agent/evidence/133/ci-portability1/author'
freeze = json.loads((author/'freeze.json').read_bytes())
for name, expected in freeze['source_bindings'].items():
    assert sha((root/name).read_bytes()) == expected
    if name != runner: assert git('show',base+':'+name) == (root/name).read_bytes()
assert git('rev-parse',base+':.nizam') == git('rev-parse',candidate+':.nizam')
lines=(author/'capture-index.sha256').read_text().splitlines()
assert len(lines)==97
for line in lines:
    expected,name=line.split('  ',1)
    assert sha((author/name).read_bytes())==expected,name
frames=list(author.glob('*/*.execution.json'))
assert len(frames)==18
for path in frames:
    frame=json.loads(path.read_bytes())
    assert frame['exercised_revision']==candidate and not frame['timed_out'] and frame['child_pid']>0
    for stream in ('stdin','stdout','stderr'):
        desc=frame.get(stream)
        if desc is None: continue
        raw=(path.parent/Path(desc['path']).name).read_bytes()
        assert len(raw)==desc['bytes'] and sha(raw)==desc['sha256']
    expected=1 if path.name.split('.')[0] in ('global-added','helper-pass','signature-added') else 0
    assert frame['actual_exit']==expected
    if expected:
        assert (path.parent/(path.name.replace('execution.json','stderr.txt'))).read_bytes()==b'ASSERTION_FAILURE: product AST outside _receipt_candidate body changed\n'
for family in ('py312','py313','py314'):
    for name in ('default-four','guard-controls'):
        before=gzip.decompress((author/family/(name+'.preservation-before.json.gz')).read_bytes())
        after=gzip.decompress((author/family/(name+'.preservation-after.json.gz')).read_bytes())
        assert before==after
        inventory=json.loads(before)
        assert len(inventory['rows'])==14804 and sum(r['path'].startswith('.nizam/') for r in inventory['rows'])==239
    output=(author/family/'default-four.stdout.txt').read_text().splitlines()
    assert [l for l in output if l.startswith('PASS ')]==['PASS '+n for n in ('real-git-count-reduction','semantic-equivalence','fresh-mutations','literal-paths-and-modes')]
print(json.dumps({'static_review':'pass','candidate':candidate,'evidence_revision':evidence,'delta':'runner2added/1removed; every other byte and all assertions retained','index_files':97,'frames':18,'preservation_pairs':6,'physical_rows':14804,'installed':239,'scope':'Static evidence inspection only; no focused/full suite execution, fresh QA or hosted runtime claim.'},sort_keys=True))
