import hashlib,json,subprocess,yaml,jsonschema
from pathlib import Path
root=Path.cwd();base='6816ea0c8356cdd0af31336bdd932decab4f2d1b';sha=lambda b:hashlib.sha256(b).hexdigest();docs=['.agent/product_spec_021.md','.agent/product_spec_018.md','docs/planning/ROADMAP.md','docs/planning/HANDOVER.md'];allpaths=docs+['.agent/feature_list_021.json']
assert set(subprocess.check_output(['git','diff','--name-only',base,'HEAD']).decode().splitlines())==set(allpaths)
for p in docs:
 old=subprocess.check_output(['git','show',base+':'+p]).decode();text=(root/p).read_text();a=yaml.safe_load(old.split('---',2)[1]);b=yaml.safe_load(text.split('---',2)[1]);assert tuple(map(int,b['version'].split('.')))>tuple(map(int,a['version'].split('.')));assert b['change_log'][0]['version']==b['version'] and b['change_log'][0]['date']=='2026-10-16';jsonschema.Draft202012Validator(json.loads((root/'schema/frontmatter.schema.json').read_text())).validate(b)
 if p.endswith(('ROADMAP.md','HANDOVER.md')): assert old[old.index('## Historical snapshot'):]==text[text.index('## Historical snapshot'):]
old=json.loads(subprocess.check_output(['git','show',base+':.agent/feature_list_021.json']));new=json.loads((root/'.agent/feature_list_021.json').read_bytes());assert new['spec_version']=='0.1.2';new['spec_version']=old['spec_version'];assert new==old
qpath=root/'.agent/qa/133.json';qraw=qpath.read_bytes();q=json.loads(qraw);assert qraw==subprocess.check_output(['git','show','5151517e459e0575209ca7851709de3ebc661588:.agent/qa/133.json']);assert len(q['checks'])==8 and len(q['all_attempts'])==9 and sum(x['exit_code']==1 for x in q['all_attempts'])==1
assert q['additional_adversarial_attempts']==1 and q['adversarial']['actual_exit']==0
for row in q['checks']: f=json.loads((root/row['evidence']).read_bytes());assert f['actual_exit']==0 and f['exercised_revision']==row['exercised_revision']
order=q['coverage']['default48_order'];sets={};aux={}
for number in (5,6):
 p=root/f'.agent/evidence/133/qa1/check-{number}.stdout.txt';data=p.read_bytes();f=json.loads((root/f'.agent/evidence/133/qa1/check-{number}.execution.json').read_bytes());assert sha(data)==f['stdout']['sha256'];labels=[s[5:] for s in data.decode().splitlines() if s.startswith('PASS ')];sets[number]=[s for s in labels if s in order];aux[number]=[s for s in labels if s.startswith('SYNTHETIC foreign-local-runtime')]
assert sets[5]==order and sets[6]==['ci-candidate-bound','ci-blocker-rejected'] and len(aux[5])==len(aux[6])==1
fixture=(root/'.agent/evidence/133/qa1/check-6.stdout.txt').read_text();assert 'SELF-TEST OK: 166/166 fixtures accounted for, 0 failed' in fixture and all(('PASS '+s) in fixture.splitlines() for s in q['coverage']['new_hook_checks'])
capraw=(root/'.agent/evidence/133/evidence-capture.json').read_bytes();cap=json.loads(capraw);assert sha(capraw).startswith('0c1c8b38');assert cap['capture_execution']['actual_exit']==0 and cap['capture_preservation']=={'rows':14645,'installed':239,'equal':True,'summary':'.agent/evidence/133/root-capture2/capture.capture-summary.json'}
assert sha((root/'tools/workflow_assurance.py').read_bytes())=='5f5e15df384e9ef41e934f644b7a218717be680ed1cec99f68c6129e1072ee9d'
s=json.loads((root/'.agent/run_state.json').read_bytes());assert s['scope_budget']['original_estimate_lines']==2000 and s['scope_budget']['ceiling_130pct']==2600 and not s['scope_budget']['per_feature'];assert s['phase_018_scope_budget_final']['total_lines_changed']==26657
p=subprocess.Popen(['git','diff','--check',base,'HEAD'],stdout=subprocess.PIPE,stderr=subprocess.PIPE);o,e=p.communicate();assert p.returncode==0
report={'review':'Independent current closeout documentation accuracy review; static only','feature':'133','reviewer':'/root/validator133','attempt':1,'limit':3,'root_release':base,'reviewed_commit':'a8c821962082a55ed48a853ef3528be32f9ac316','documents':{p:sha((root/p).read_bytes()) for p in allpaths},'issues':[{'id':'133-CLOSEOUT1-COUNTS','severity':'medium','criterion':'Each current factual view must distinguish actual default bank execution from shell fixture coverage.','evidence':'.agent/product_spec_021.md current-local-acceptance and ROADMAP/HANDOVER current133 paragraphs claim both long suites retained all48 ordered cases plus auxiliary. Actual sealed QAcheck5 stdout has48 ordered labels andoneaux; QAcheck6 stdout has only ci-candidate-bound/ci-blocker-rejected from that48,oneaux,166fixturefiles andfour new hookchecks.','required_fix':'Correct those three current wording sites to attribute48+oneaux to defaultcheck5, and two selected WA cases+oneaux/166files/four new checks to fixturecheck6. Preserve recorded tests/counts/QA/evidence and every other historical/current fact; no test or acceptance change.'}],'missing_acceptance_coverage':[],'unsupported_claims':[],'confirmed':['Exact authorized five-file scope; four NDS versions/dates/schema valid and featurelist spec_version alone synchronized. Historical ROADMAP/HANDOVER bodies remain byte-identical; no acceptance/lifecycle/allowance/Source/installed/budget edit.','QA5151517e retains eight selected actual0 across cb5/b225, nine actualmandatory with original7failure1 and exactlyoneextra0. SourceAPI5f and Rootcapture0c1c hash bind local results; capture14645/239 unchanged. No single-head/all-attempts-pass or elapsed-time/comparative claim.','Oldmain38817712498 is explicitly qualified00:10snapshot pending/allfive required; local canonical complete is distinct from final accounting/newPR/merge/main delivery.2000/2600 remains unmeasured; old018archive26657 failure/11990source-only and original allowances, partial016, future020/019, old123historicalproof and installedv1.5 remain preserved.','Planner static0/PID2974918 is a structural check, not evidence that the erroneous both-suite count is accurate. Its missing-output-directory wrapperfailure remains original history; no behavior or test rerun by Validator.'],'evidence':{'static_frame':'/home/cnross/.tmp/nizam-133-closeoutdocs-review1/review.execution.json','static_stdout':'/home/cnross/.tmp/nizam-133-closeoutdocs-review1/review.stdout.txt','qa_sha256':sha(qraw),'capture_sha256':sha(capraw),'default_wa_cases':len(sets[5]),'fixture_wa_cases':sets[6],'each_auxiliary':1,'fixture_files':166,'new_hook_checks':4,'diff_check_pid':p.pid,'diff_check_actual_exit':p.returncode},'scope':'Own current-doc review branch froma8c only; no held future proposal imported, Source/assertion/Rootstate/debt/budget edit, interim scope count, test/CI/install/model/benchmark execution.','final_verdict':{'approved':False,'summary':'Reject only overstatement of fixture-suite WA coverage in three current views; all other checked lifecycle, evidence, preservation, budget and delivery distinctions are supported.'}}
for schema in ('schema/contract_review.schema.json','.nizam/schema/contract_review.schema.json'):jsonschema.Draft202012Validator(json.loads((root/schema).read_text())).validate(report)
target=root/'.agent/validator/133-closeoutdocs1.json';assert not target.exists();target.write_text(json.dumps(report,indent=2)+chr(10));print(json.dumps(dict(verdict_sha256=sha(target.read_bytes()),both_schemas_valid=True,default_wa_cases=len(sets[5]),fixture_wa_cases=sets[6],actual_static_result='complete; narrow factual rejection',test_or_scope_count_execution=False),sort_keys=True))
