from pathlib import Path
import json,hashlib,subprocess
base='60407ff13bab5d08a86e23aa158851c4da13f761'
expected={'.agent/product_spec_021.md':('Both long suites retained all 48 cases in order plus one auxiliary observer message;\nthe fixture suite retained 166 files and separately ran four new hook checks.','Default check 5 ran all 48 cases in order plus one auxiliary observer message.\nFixture check 6 ran the two selected Workflow Assurance cases `ci-candidate-bound`\nand `ci-blocker-rejected`, one auxiliary observer message, 166 fixture files and\nfour new hook checks.')}
for name in ['docs/planning/ROADMAP.md','docs/planning/HANDOVER.md']:
 expected[name]=('Both long suites retained 48 ordered cases plus one auxiliary message; the shell suite retained 166 fixture files plus four distinct new hook checks.','Default check 5 ran 48 ordered Workflow Assurance cases plus one auxiliary message; fixture check 6 ran the two selected Workflow Assurance cases `ci-candidate-bound`/`ci-blocker-rejected`, one auxiliary message, 166 fixture files and four distinct new hook checks.')
assert subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()==base
assert sorted(subprocess.check_output(['git','diff','--cached','--name-only'],text=True).splitlines())==sorted(expected)
assert not subprocess.check_output(['git','diff','--name-only'],text=True)
for name,(old,new) in expected.items():
 prior=subprocess.check_output(['git','show',base+':'+name],text=True);current=Path(name).read_text();assert prior.count(old)==1 and current==prior.replace(old,new,1)
 print(name,hashlib.sha256(Path(name).read_bytes()).hexdigest())
qa=json.loads(Path('.agent/qa/133.json').read_text());default=qa['coverage']['default48_order'];assert len(default)==48
for i,want in [(5,default),(6,['ci-candidate-bound','ci-blocker-rejected'])]:
 lines=Path(f'.agent/evidence/133/qa1/check-{i}.stdout.txt').read_text().splitlines();labels=[s.removeprefix('PASS ') for s in lines if s.startswith('PASS ')]
 assert [s for s in labels if s in default]==want
 assert len([s for s in labels if s.startswith('SYNTHETIC foreign-local-runtime observation;')])==1
 if i==6:
  assert [s for s in labels if s in qa['coverage']['new_hook_checks']]==qa['coverage']['new_hook_checks']
  assert 'SELF-TEST OK: 166/166 fixtures accounted for, 0 failed' in lines
subprocess.run(['git','diff','--cached','--check'],check=True)
print('PASS exact three prose replacements only; all other bytes unchanged; actual sealed default48+aux distinct from fixture2WA+aux/166files/four checks. Static read only; no tests or scope count.')
