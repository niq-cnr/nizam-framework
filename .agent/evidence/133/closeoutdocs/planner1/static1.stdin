from pathlib import Path
import hashlib,json,re,subprocess
import jsonschema,yaml
base='6816ea0c8356cdd0af31336bdd932decab4f2d1b'
paths=['.agent/product_spec_021.md','.agent/product_spec_018.md','.agent/feature_list_021.json','docs/planning/ROADMAP.md','docs/planning/HANDOVER.md']
assert subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()==base
assert sorted(subprocess.check_output(['git','diff','--cached','--name-only'],text=True).splitlines())==sorted(paths)
assert not subprocess.check_output(['git','diff','--name-only'],text=True)
def old(path):return subprocess.check_output(['git','show',base+':'+path],text=True)
for name in paths:
 p=Path(name);s=p.read_text()
 if name.endswith('.md'):
  fm=yaml.safe_load(s.split('---',2)[1])
  for schema in ['schema/frontmatter.schema.json','.nizam/schema/frontmatter.schema.json']:jsonschema.validate(fm,json.loads(Path(schema).read_text()))
  marker='## Historical snapshot — '
  if marker in s:assert s[s.index(marker):]==old(name)[old(name).index(marker):]
  current=s.split(marker,1)[0]
  for target in re.findall(r'\]\(([^)]+)\)',current):
   if not target.startswith('https:'):assert (p.parent/target).exists(),(name,target)
 print(name,hashlib.sha256(p.read_bytes()).hexdigest())
f=json.loads(Path(paths[2]).read_text());prior=json.loads(old(paths[2]));assert f.pop('spec_version')=='0.1.2';prior.pop('spec_version');assert f==prior
jsonschema.validate(json.loads(Path(paths[2]).read_text()),json.loads(Path('schema/feature_list.schema.json').read_text()))
for path,digest in [('.agent/evidence/133/evidence-capture.json','0c1c8b38005e9e8126800aff0d5c0cd0d5f8383e6389ba4d6503bb3551300fb8'),('tools/workflow_assurance.py','5f5e15df384e9ef41e934f644b7a218717be680ed1cec99f68c6129e1072ee9d')]:assert hashlib.sha256(Path(path).read_bytes()).hexdigest()==digest
qa=json.loads(Path('.agent/qa/133.json').read_text());assert qa['checks_passed']==qa['checks_run']==8 and qa['actual_mandatory_attempts']==9 and qa['additional_adversarial_attempts']==1
assert qa['all_attempts'][6]['exit_code']==1 and qa['qa_pass'] is True
for name in paths[1:2]:
 marker='## Full counted proposed budget';assert Path(name).read_text().split(marker,1)[1]==old(name).split(marker,1)[1]
subprocess.run(['git','diff','--cached','--check'],check=True)
print('PASS exact five-file scope, root+installed NDS schemas, feature schema/spec-only sync, historical body and018budget preservation, current links, immutable capture/Source and QA facts, whitespace. Static only; no product/tests/full validation or scope measurement.')
