import hashlib,json,subprocess,jsonschema
from pathlib import Path
root=Path.cwd();sha=lambda b:hashlib.sha256(b).hexdigest();base='60407ff13bab5d08a86e23aa158851c4da13f761';revision='f5ee665e6a8fb0c73c0b945144ca7c620a6e6666';paths=['.agent/product_spec_021.md','docs/planning/ROADMAP.md','docs/planning/HANDOVER.md']
assert set(subprocess.check_output(['git','diff','--name-only',base,'HEAD']).decode().splitlines())==set(paths)
oldparagraph='Both long suites retained 48 ordered cases plus one auxiliary message; the shell suite retained 166 fixture files plus four distinct new hook checks.'
newparagraph='Default check 5 ran 48 ordered Workflow Assurance cases plus one auxiliary message; fixture check 6 ran the two selected Workflow Assurance cases `ci-candidate-bound`/`ci-blocker-rejected`, one auxiliary message, 166 fixture files and four distinct new hook checks.'
for path in paths:
 old=subprocess.check_output(['git','show',base+':'+path]).decode();new=(root/path).read_text()
 if path.endswith('product_spec_021.md'):
  a='Both long suites retained all 48 cases in order plus one auxiliary observer message;'+chr(10)+'the fixture suite retained 166 files and separately ran four new hook checks.'
  b='Default check 5 ran all 48 cases in order plus one auxiliary observer message.'+chr(10)+'Fixture check 6 ran the two selected Workflow Assurance cases `ci-candidate-bound`'+chr(10)+'and `ci-blocker-rejected`, one auxiliary observer message, 166 fixture files and'+chr(10)+'four new hook checks.'
 else:a,b=oldparagraph,newparagraph
 assert old.count(a)==new.count(b)==1 and new.replace(b,a)==old
priorpath='.agent/validator/133-closeoutdocs1.json';priorraw=(root/priorpath).read_bytes();assert sha(priorraw)=='e5f8976dd5886ad6a583196c44bf84b61b0e444d8264876aec4dcfbe49d964c5';prior=json.loads(priorraw)
assert sha((root/'.agent/qa/133.json').read_bytes())==prior['evidence']['qa_sha256'] and sha((root/'.agent/evidence/133/evidence-capture.json').read_bytes())==prior['evidence']['capture_sha256']
q=json.loads((root/'.agent/qa/133.json').read_bytes());order=q['coverage']['default48_order'];actual={}
for n in (5,6):
 data=(root/f'.agent/evidence/133/qa1/check-{n}.stdout.txt').read_bytes();frame=json.loads((root/f'.agent/evidence/133/qa1/check-{n}.execution.json').read_bytes());assert sha(data)==frame['stdout']['sha256'];actual[n]=[s[5:] for s in data.decode().splitlines() if s.startswith('PASS ') and s[5:] in order]
assert actual[5]==order and actual[6]==['ci-candidate-bound','ci-blocker-rejected']
for path in ('.agent/product_spec_018.md','.agent/feature_list_021.json','.agent/run_state.json','docs/planning/DEBT.md','tools/workflow_assurance.py','tools/test_receipt_candidate_batching.py','tools/fixtures_self_test.sh','.agent/contracts/133.json'):assert (root/path).read_bytes()==subprocess.check_output(['git','show',base+':'+path])
p=subprocess.Popen(['git','diff','--check',base,'HEAD'],stdout=subprocess.PIPE,stderr=subprocess.PIPE);o,e=p.communicate();assert p.returncode==0
report={'review':'Independent current closeout documentation accuracy review2; static only','feature':'133','reviewer':'/root/validator133','attempt':2,'limit':3,'root_release':'bbc47b1b','reviewed_commit':revision,'baseline':base,'documents':{path:sha((root/path).read_bytes()) for path in paths},'prior_rejection':{'revision':base,'path':priorpath,'sha256':sha(priorraw),'issue':'133-CLOSEOUT1-COUNTS','disposition':'Fixed only the three current coverage sentences; original rejected record and evidence remain unchanged.'},'confirmed':['Exact three prose replacements; reversing only those replacements reproduces complete prior file bytes. Every other a8c field, NDS/history/018spec/021featurelist/Source/tests/contract/state/debt/budget is unchanged. No held future lineage imported into current branch.','Corrected defaultcheck5 attribution48 ordered WA cases plusoneaux and fixturecheck6 attributiontwo named selected WA cases plusoneaux/166files/four newchecks matches original sealed QA stdout. No rerun or changed count/test evidence.','Original independently checked QA5151517e and Rootcapture0c1c are byte-identical. Eight selected0 across cb5/b225, nine mandatory attempts including original7failure1, exactlyoneextra0, SourceAPI5f and14645/239capture remain truthful.','Qualified00:10oldmainpending snapshot, final accounting/newexactheadPR/merge/main gates, unmeasured2000/2600, failed018archive/oldallowances/partial016/future020/019, immutableinstalledv1.5 and historical123proof boundaries remain as reviewed. No speedup, comparative, release or allattempts/singlehead pass claimed.'],'evidence':{'static_frame':'/home/cnross/.tmp/nizam-133-closeoutdocs-review2/review.execution.json','static_stdout':'/home/cnross/.tmp/nizam-133-closeoutdocs-review2/review.stdout.txt','prior_static_frame':'/home/cnross/.tmp/nizam-133-closeoutdocs-review1/review.execution.json','diff_check_pid':p.pid,'diff_check_actual_exit':p.returncode},'scope':'Current-doc accuracy only, no Source/assertion/acceptance/lifecycle/scope change or tests/CI/install/benchmark/model/interimaccounting execution.','final_verdict':{'approved':True,'summary':'Approve corrected current closeout views: suite coverage now matches actual retained evidence and all other previously reviewed facts remain unchanged.'},'issues':[],'missing_acceptance_coverage':[],'unsupported_claims':[]}
for schema in ('schema/contract_review.schema.json','.nizam/schema/contract_review.schema.json'):jsonschema.Draft202012Validator(json.loads((root/schema).read_text())).validate(report)
target=root/'.agent/validator/133-closeoutdocs2.json';assert not target.exists();target.write_text(json.dumps(report,indent=2)+chr(10));print(json.dumps(dict(verdict_sha256=sha(target.read_bytes()),only_three_prose_replacements=True,both_schemas_valid=True,approved=True,test_or_interim_scope_execution=False),sort_keys=True))
