from pathlib import Path
import hashlib,json,subprocess
proposal="205b5152dfc18cbab2c42ea25cd39ce92a295038"; plan=".agent/evidence/129/implementation3/architecture-preparation1.json"
def blob(rev,path): return subprocess.check_output(["git","show",rev+":"+path])
def sha(raw): return hashlib.sha256(raw).hexdigest()
raw=blob(proposal,plan);assert raw==Path(plan).read_bytes();assert sha(raw)=="40d49a6a7ff296e5fe4956fc66bb1baebf92fbae49b30d366f12e43be3b09b6f"
print(json.dumps({"proposal_revision":proposal,"path":plan,"sha256":sha(raw),"root_copy_identical":True,"actual_parent":subprocess.check_output(["git","rev-parse",proposal+"^"],text=True).strip()}))
for path,want in {".agent/contracts/129.json":"71c6374a6bd88a1110de3fceb612a1392f0b203736e13843caace9fec52c26e6","tools/test_runtime_session.py":"d186e915424040b32ee9c232d952a170ec0a806cf415126abf34a8a81eda0431",".agent/evidence/123/fresh-qa-capture1.py":"e9e9417c39548919b892f0b7436b885b72a26b781d15455e62daebe9367c5ac0"}.items():
 actual=sha(Path(path).read_bytes());assert actual==want;print(json.dumps({"protected_path":path,"sha256":actual}))
for path,want in {"tools/runtime_session.py":"aae6a5cbe09435e39c29153469a9ca13f45065e6248ff70ca44f6ce9bc5d8fa5","tools/sbcl_session_loop.lisp":"2ad3d3b633637e305e428169654929aec80577f55d90477338071247cb5f0cf9"}.items():
 actual=sha(blob("f9fe6d441a94a94798bd42071827b4f2d264be49",path));assert actual==want;print(json.dumps({"protected_source2_path":path,"sha256":actual}))
correct="10ee9b2406df5141b2aed9aaa1a022416ad74117";prior=".agent/validator/129-source3-architecture1.json";assert blob(correct,prior)==Path(prior).read_bytes()
bad="0ee9b2406df5141b2aed9aaa1a022416ad74117";check=subprocess.run(["git","rev-parse","--verify",bad+"^{commit}"],capture_output=True,text=True)
assert check.returncode!=0;print(json.dumps({"prior_review_actual_revision":correct,"prior_review_sha256":sha(blob(correct,prior)),"plan_citation_invalid":bad,"negative_lookup_actual_exit":check.returncode,"negative_lookup_stdout":check.stdout,"negative_lookup_stderr":check.stderr}))
state=json.loads(Path(".agent/run_state.json").read_text());counter=state["circuit_breaker"]["129-source3-architecture-review"];assert counter["attempts"]==2 and counter["revision"]==correct
print(json.dumps({"authorized_counter":counter}))
for number,line in enumerate(raw.decode().splitlines(),1):
 if number==8 or 79<=number<=91: print(f"PLAN {proposal}:{plan}:{number}: {line}")
print("STATIC_ONLY: no product import, runtime, probes, tests or acceptance execution")
