from pathlib import Path
import json,hashlib,shlex
r=Path.cwd();old=r/'.agent/evidence/129/implementation3/validation1';d=r/'.agent/evidence/129/implementation3/environment-continuation1';a=r/'.agent/evidence/129/source3-generator-root-admission1'
h=lambda b:hashlib.sha256(b).hexdigest()
f=json.loads((a/'admission.execution.json').read_text());assert f['actual_exit']==1 and f['child_pid']==38762
assert h((a/'admission.stdin').read_bytes())=='0f35299d5d0cb9e0af0fa97bf52034e0da506ae24b2cfd5d870ef658a49a4687'
assert 'File "<stdin>", line 28' in (a/'admission.stderr.txt').read_text()
lines=(a/'admission.stdout.txt').read_text().splitlines();assert len(lines)==12 and all(x.startswith('PASS ') and x.endswith('all16455/239 equal') for x in lines)
for k in ['stdin','stdout','stderr']:
 x=f[k];b=(a/Path(x['path']).name).read_bytes();assert h(b)==x['sha256'] and len(b)==x['bytes']
contract=json.loads((r/'.agent/contracts/129.json').read_text());required=set()
for x in contract['verification']:
 tokens=shlex.split(x['command'])
 if tokens[0]=='PYTHONDONTWRITEBYTECODE=1':tokens=tokens[1:]
 required.add(tuple(tokens))
receipt=json.loads((d/'receipt.json').read_text());seen=set()
for base,names in [(old,['admission','capture','termination']),(d,[x['name'] for x in receipt['continuation_results']])]:
 for name in names:
  f=json.loads((base/(name+'.execution.json')).read_text());argv=f['argv']
  if base==d:assert argv[:2]==['env','TMPDIR=/tmp'];argv=argv[2:]
  assert f['actual_exit']==0 and f['exercised_revision']=='0697bfe5e121543b2aa8ed8c8607d0c50e99b413';seen.add(tuple(argv))
assert len(seen)==11 and seen==required
for x in receipt['retained_prior_results']:assert h((r/x['frame']).read_bytes())==x['frame_sha256']
original=json.loads((old/'printing.execution.json').read_text());assert original['actual_exit']==2 and original['child_pid']==4147568
assert h((r/'tools/runtime_session.py').read_bytes())=='fe5917389ee3bdec342bd440d7ce48adf7d7e933cb4cf3f4dc1d1bbb1cecb345' and not (r/'tools/sbcl_session_loop.lisp').exists()
print('PASS corrected command coverage preserves bash; all11 exact argv mapped, prior proof hashes verified, originalprinting2 retained; first12 fullpreservation checks already reached before bookkeeping error; no native rerun or product adoption')
