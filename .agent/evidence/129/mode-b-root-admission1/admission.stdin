from pathlib import Path
import json,hashlib
r=Path.cwd();d=r/'.agent/evidence/129/mode-b1'
v=json.loads((r/'.agent/validator/129-mode-b.json').read_text());assert v['final_verdict']['approved'] is False
assert [x['id'] for x in v['issues']]==['129-B1','129-B2'] and v['missing_acceptance_coverage']==[] and v['unsupported_claims']==[]
assert v['candidate_revision']=='0697bfe5e121543b2aa8ed8c8607d0c50e99b413'
for name,pid in [('static1',50795),('proof1',122639)]:
 f=json.loads((d/(name+'.execution.json')).read_text());assert f['actual_exit']==0 and f['child_pid']==pid and not f['timed_out']
 for k in ['stdin','stdout','stderr']:
  x=f[k];b=(d/Path(x['path']).name).read_bytes();assert hashlib.sha256(b).hexdigest()==x['sha256'] and len(b)==x['bytes']
print('PASS canonical rejection and actual static/proof captures verified; all11Generatorpositive preserved; no cost/QA/source approval')
