import ast,gzip,hashlib,json,os,socket,stat,subprocess,tempfile
from pathlib import Path
sha=lambda b:hashlib.sha256(b).hexdigest()
def git(*a):return subprocess.check_output(['git',*a]).decode().strip()
def blob(r,p):return subprocess.check_output(['git','show',r+':'+p])
def installed():
 result={}
 for p in sorted(Path('.nizam').rglob('*')):
  if p.is_file():
   assert not p.is_symlink(),str(p)
   result[p.as_posix()]={'sha256':sha(p.read_bytes()),'bytes':p.stat().st_size,'mode':stat.S_IMODE(p.stat().st_mode)}
 assert len(result)==239
 return result
release='4621c2fb6d0d7dbbde57b4fbf5b128a7245a7fbe';tested='0697bfe5e121543b2aa8ed8c8607d0c50e99b413';product='a9114bcbe16fba76dbdba1147ea76db8a5a6b39d'
assert git('rev-parse','HEAD')==release and git('status','--porcelain=v1','--untracked-files=all')==''
state=json.loads(Path('.agent/run_state.json').read_bytes());assert state['circuit_breaker']['129-source3-environment-diagnosis']['attempts']==1
before=installed();b=Path('.agent/evidence/129/implementation3/validation1');receipt=json.loads((b/'receipt.json').read_bytes());index=json.loads((b/'raw-index.json').read_bytes())
for name,row in index.items():
 assert Path(name).name==name and set(row)=={'sha256','bytes'}
 data=(b/name).read_bytes();assert sha(data)==row['sha256'] and len(data)==row['bytes'],name
bindings={}
for p,expected in {**receipt['product_sha256'],**receipt['protected_sha256']}.items():
 raw=blob(tested,p);assert sha(raw)==expected,(p,sha(raw),expected);bindings[p]=expected
for p in receipt['product_sha256']:assert blob(product,p)==blob(tested,p)
assert sha(Path('tools/test_runtime_session.py').read_bytes())==bindings['tools/test_runtime_session.py']=='d186e915424040b32ee9c232d952a170ec0a806cf415126abf34a8a81eda0431'
assert sha(Path('tools/runtime_session.py').read_bytes())=='fe5917389ee3bdec342bd440d7ce48adf7d7e933cb4cf3f4dc1d1bbb1cecb345'
assert not Path('tools/sbcl_session_loop.lisp').exists()
frames={}
for name,expected in [('admission',0),('capture',0),('termination',0),('printing',2),('idle-close',0)]:
 frame=json.loads((b/(name+'.execution.json')).read_bytes());summary=json.loads((b/(name+'.capture-summary.json')).read_bytes())
 assert frame['exercised_revision']==tested and frame['actual_exit']==expected and not frame['timed_out']
 for stream in ['stdout','stderr']:
  data=(b/(name+'.'+stream+'.txt')).read_bytes();assert sha(data)==frame[stream]['sha256'] and len(data)==frame[stream]['bytes']
 prior=json.loads(gzip.decompress((b/(name+'.preservation-before.json.gz')).read_bytes()));after=json.loads(gzip.decompress((b/(name+'.preservation-after.json.gz')).read_bytes()))
 assert prior==after and summary['preservation_equal'] and summary['before']['installed']==239 and summary['after']['installed']==239
 assert sum(x['path'].startswith('.nizam/') for x in prior['rows'])==239
 frames[name]={'actual_exit':expected,'pid':frame['child_pid'],'argv':frame['argv'],'revision':frame['exercised_revision'],'preservation_equal':True,'installed':239,'inventory_sha256':summary['before']['inventory_sha256']}
lines=(b/'printing.stdout.txt').read_text().splitlines();commands=[json.loads(x[len('LIVE_COMMAND '):]) for x in lines if x.startswith('LIVE_COMMAND ')]
peer=next(x for x in commands if x['pid']==4148574);assert peer['exit']==70 and json.loads(peer['stdout'])=={'error':'infrastructure','ok':False} and not peer['stderr']
request_root=peer['argv'][peer['argv'].index('--root')+1];endpoint=request_root+'/live/control.sock';assert endpoint==receipt['failed_peer']['endpoint'] and len(endpoint.encode())==109
assert not Path(request_root).exists()
controller=blob(tested,'tools/runtime_session.py').decode();runner=blob(tested,'tools/test_runtime_session.py').decode()
checks={
 'absolute_resolved_root':'client(args.action, root.resolve(), request)' in controller,
 'absolute_unix_bind':"endpoint = self.directory / 'control.sock'" in controller and 'self.server.bind(str(endpoint))' in controller,
 'generic_infrastructure_exception':"except (OSError, ValueError, KeyError, TypeError):\n        response = response_error('infrastructure')" in controller,
 'fixture_default_temp_root':"with tempfile.TemporaryDirectory(prefix='n129-') as temp:" in runner,
 'nested_rendered_dir':"with tempfile.TemporaryDirectory(prefix='rendered-overflow-', dir=home) as temp:" in runner,
 'nested_fresh_positive':"with tempfile.TemporaryDirectory(prefix='overflow-positive-', dir=s.home) as fresh:" in runner,
 'fresh_positive_intact':"peer.start(executable); live_nonce(peer, os.urandom(16).hex())" in runner and "fresh overflow positive preserves governed attempt" in runner,
 'tmpdir_preserved_by_session_env':"self.env = {k: v for k, v in os.environ.items()" in runner and "if k not in ('PYTHONPATH', 'PYTHONHOME', 'CL_SOURCE_REGISTRY', 'ASDF_OUTPUT_TRANSLATIONS')" in runner
};assert all(checks.values()),checks
# One direct qualification: only our own disposable AF_UNIX sockets; no product imports or dispatch.
qualification=[]
with tempfile.TemporaryDirectory(prefix='n129-env-',dir='/tmp') as scratch:
 scratch=Path(scratch).resolve();assert len(str(scratch).encode())<90
 for target in [107,109]:
  p=scratch/('s'*(target-len(str(scratch).encode())-1));assert len(str(p).encode())==target
  s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
  row={'pathname_utf8_bytes':target,'path':str(p)}
  try:
   s.bind(str(p));s.listen(1);row.update(bound=True,error=None)
  except OSError as e:
   row.update(bound=False,error={'type':type(e).__name__,'message':str(e),'errno':e.errno})
  finally:
   s.close()
   if p.exists():p.unlink()
  qualification.append(row)
  assert not p.exists()
 assert qualification[0]['bound'] is True and qualification[1]['bound'] is False
 assert qualification[1]['error']['message']=='AF_UNIX path too long'
 scratch_path=str(scratch)
assert not Path(scratch_path).exists()
old='/home/cnross/.tmp';assert endpoint.startswith(old+'/');suffix=endpoint[len(old):]
assert len(old.encode())==16 and len(suffix.encode())==93
new_limit=12;predicted=new_limit+len(suffix.encode());assert predicted==105
final=installed();assert final==before
print(json.dumps({'kind':'narrow static plus one direct AF_UNIX boundary qualification; no runtime/controller/test selector dispatched','release':release,'source_evidence_revision':'73961d78b9b3eba221e1bd0951befc1a8aa08dfd','tested_revision':tested,'product_revision':product,'raw_index_sha256':sha((b/'raw-index.json').read_bytes()),'raw_index_shape':'basename -> {sha256, bytes}; every entry verified','receipt_sha256':sha((b/'receipt.json').read_bytes()),'candidate_bindings':bindings,'frames':frames,'failed_peer':peer,'failed_endpoint':endpoint,'failed_endpoint_utf8_bytes':109,'static_checks':checks,'qualification':qualification,'qualification_scratch_removed':True,'tmpdir_proposal':{'resolved_absolute_directory_max_utf8_bytes':12,'private_mode':'0700','example_shape':'/tmp/ plus six random hexadecimal characters','old_tmpdir_utf8_bytes':16,'frozen_nested_suffix_utf8_bytes':93,'predicted_max_for_this_nested_peer':predicted,'root_authorization_required':True},'original_failure_limit':'No original errno or remaining failed-peer scratch/logs; supported inference, not recovered bind traceback. No product pass inferred.','installed_before':before,'installed_after_equal':final==before,'status_after':git('status','--porcelain=v1','--untracked-files=all')},sort_keys=True,indent=2))
