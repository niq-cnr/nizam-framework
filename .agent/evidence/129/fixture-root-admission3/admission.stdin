
import pathlib,json,hashlib,gzip,subprocess
r=pathlib.Path.cwd();sha=lambda b:hashlib.sha256(b).hexdigest();load=lambda p:json.loads(p.read_text());vp=r/'.agent/validator/129-postsource-fixture3.json';v=load(vp)
assert sha(vp.read_bytes())=='ffed0d1a3cb7eb5c72fe4fc3bf40e5ebb3e6127c4e69e53346cabde3cd0020fa' and v['final_verdict']['approved'] is True and all(v[k]==[] for k in ['issues','missing_acceptance_coverage','unsupported_claims'])
for p,h in load(r/v['evidence']['index']).items():assert sha((r/p).read_bytes())==h,p
base=r/'.agent/evidence/129/fixture-correction2';index=load(base/'raw-index.json');assert len(index)==15
for n,row in index.items():
 b=(base/n).read_bytes();assert sha(b)==row['sha256'] and len(b)==row['bytes'],n
for base,name,pid,rev in [(r/'.agent/evidence/129/postsource-fixture-review3','static1',3970823,'de197611c7799077f4991dc0efbfea0bf871e977'),(base,'static1',3941310,'abc822f1cca7d246c82557e9181f051fb40f6cfc'),(base,'native1',3944220,'abc822f1cca7d246c82557e9181f051fb40f6cfc')]:
 f=load(base/(name+'.execution.json'));assert f['actual_exit']==0 and f['child_pid']==pid and f['exercised_revision']==rev and not f['timed_out']
 for k in ['stdout','stderr','stdin']:
  if f.get(k):
   b=(base/pathlib.Path(f[k]['path']).name).read_bytes();assert sha(b)==f[k]['sha256'] and len(b)==f[k]['bytes']
base=r/'.agent/evidence/129/fixture-correction2';before=json.loads(gzip.decompress((base/'native1.preservation-before.json.gz').read_bytes()));after=json.loads(gzip.decompress((base/'native1.preservation-after.json.gz').read_bytes()));assert before==after and before['head']==v['bundle']['revision'] and before['status']=='' and len(before['rows'])==15960 and sum(x['path'].startswith('.nizam/') for x in before['rows'])==239
native={x.partition(' ')[0]:json.loads(x.partition(' ')[2]) for x in (base/'native1.stdout.txt').read_text().splitlines()};assert native['NATIVE_RESULT']['observed_descendant_dead_after_group_KILL'] is True and native['NATIVE_RESULT']['unrelated_survived'] is True and native['NATIVE_READY']['actual_TERM_ignored_with_progress'] is True and native['NATIVE_AFTER_GROUP_TERM']['leader_live_token'] is None and native['NATIVE_AFTER_GROUP_TERM']['descendant_still_live_token'] is not None and native['NATIVE_CLEANUP']['remaining_owned']=={}
old=load(r/'.agent/evidence/129/frozen-bundle2.json')['bundle'];expected=dict(old,revision='abc822f1cca7d246c82557e9181f051fb40f6cfc',runner_git_blob='5af7a9f5683886dff6b607ec39f87490b9cddbd9',runner_sha256='d186e915424040b32ee9c232d952a170ec0a806cf415126abf34a8a81eda0431');assert v['bundle']==expected and sha((r/'tools/test_runtime_session.py').read_bytes())==expected['runner_sha256']
assert sha((r/'.agent/contracts/129.json').read_bytes())==expected['contract_sha256'] and sha((r/'.agent/evidence/129/interface-intent1.json').read_bytes())==expected['interface_sha256']
assert sha((r/'tools/runtime_session.py').read_bytes())=='fe5917389ee3bdec342bd440d7ce48adf7d7e933cb4cf3f4dc1d1bbb1cecb345' and not (r/'tools/sbcl_session_loop.lisp').exists()
assert subprocess.check_output(['git','rev-parse','archive/129-fixture-author2-prequalification-a3dffed6']).decode().strip()=='a3dffed6e895ae6a3e039f36d5d2f95e6bbcfe24'
identity=sha(json.dumps(expected,sort_keys=True,separators=(',',':')).encode());assert identity==v['bundle_identity_sha256']=='bd6d2638a0a636993047b09e3aca985e1facee6472abf15d5d3fa225d4c2fe7b'
print(json.dumps({'admitted':'complete amended independent acceptance bundle and native fixture qualification only','bundle':identity,'installed_files':239,'physical_rows':15960,'Source3_released':False},sort_keys=True))
