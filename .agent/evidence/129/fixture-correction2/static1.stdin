import ast, hashlib, json, subprocess
from pathlib import Path
base='4acf595f78463185e42bf84c1303ed8008c2d211'; path='tools/test_runtime_session.py'
def git(*args): return subprocess.check_output(['git',*args])
def sha(b): return hashlib.sha256(b).hexdigest()
old=git('show',base+':'+path); new=Path(path).read_bytes()
assert sha(old)=='a61a2ec17e729a6c6ea0b9090a639beb0903db49c4d9869b948d908d568bdf1e'
assert new==git('show','HEAD:'+path)
oldtree,newtree=map(ast.parse,(old,new))
def definitions(tree): return {n.name:ast.dump(n) for n in tree.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
a,b=map(definitions,(oldtree,newtree))
changed=sorted(name for name in a if a[name]!=b[name]); added=sorted(set(b)-set(a))
assert changed==['live_rendered_overflow_control','live_scenario','live_terminate','live_unresolved_capture'],changed
assert added==['group_descendant_fixture','live_group_descendant','live_partial_frame_deadline'],added
assert not set(a)-set(b)
def assertions(tree):
 return [ast.dump(n) for n in ast.walk(tree) if isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id=='require']
# All old assertions remain byte-for-AST identical except the diagnosed path comparison.
expected=ast.parse(old.replace(b"before['outstanding_operation_ref'] == request['operation_id'] and",b"before['outstanding_operation_ref'] == str(s.operation(request['operation_id']).resolve()) and",1))
from collections import Counter
assert not Counter(assertions(expected))-Counter(assertions(newtree))
assert git('diff','--name-only',base,'HEAD').decode().splitlines()==[path]
assert all(line.startswith('?? .agent/evidence/129/fixture-correction2/') for line in git('status','--porcelain','--untracked-files=all').decode().splitlines())
pins={'tools/runtime_session.py':'fe5917389ee3bdec342bd440d7ce48adf7d7e933cb4cf3f4dc1d1bbb1cecb345','.agent/contracts/129.json':'71c6374a6bd88a1110de3fceb612a1392f0b203736e13843caace9fec52c26e6','.agent/evidence/129/interface-intent1.json':'402e7d02486f7ff29697433c13d05d9d86b691c67eba2310a24bc0817cbbf773','.agent/validator/129-source2-recovery1.json':'46a4a9899cc5880a154423236b01c580f6fbd2b5dc412e40105a489d1e2c0482'}
for p,h in pins.items(): assert sha(Path(p).read_bytes())==h,p
assert len(json.loads(Path('.agent/contracts/129.json').read_text())['verification'])==11
assert not Path('tools/sbcl_session_loop.lisp').exists()
installed=git('ls-files','-z','.nizam').split(b'\0')[:-1]; assert len(installed)==239
for raw in installed:
 p=raw.decode(); assert Path(p).read_bytes()==git('show',base+':'+p),p
print(json.dumps({'result':'PASS static only','revision':git('rev-parse','HEAD').decode().strip(),'runner_sha256':sha(new),'runner_git_blob':git('rev-parse','HEAD:'+path).decode().strip(),'changed_functions':changed,'added_functions':added,'all_old_assertions_preserved_except_diagnosed_path':True,'contract_commands':11,'unchanged_pins':pins,'installed_files_verified':239,'product_backend_absent':True,'runtime_or_controller_executed':False},sort_keys=True))
