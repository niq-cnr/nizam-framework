import ast, hashlib, json, os, shutil, signal, subprocess, sys, tempfile, time
from pathlib import Path
output=Path(sys.argv[1]); started=time.monotonic()
tree=ast.parse(Path('tools/test_runtime_session.py').read_bytes())
nodes=[n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name in ('group_descendant_fixture','process_token','live_owned')]
assert len(nodes)==3
exec(compile(ast.Module(body=nodes,type_ignores=[]),'<committed-private-fixture>','exec'))
def wait_for_native(call, seconds=2):
 end=time.monotonic()+seconds
 while time.monotonic()<end:
  value=call()
  if value: return value
  time.sleep(.01)
 raise AssertionError('native qualification observation timeout')
executable=str(Path(shutil.which('sbcl')).resolve()); nonce=os.urandom(16).hex(); marker=os.urandom(24).hex()
with tempfile.TemporaryDirectory(prefix='private-native-',dir=output) as temp:
 form, ready, pulse=group_descendant_fixture(Path(temp),'qualification-group-1',nonce)
 (output/'native-expression.lisp').write_text(form+'\n')
 argv=[executable,'--no-sysinit','--no-userinit','--non-interactive','--eval',form,'--eval','(format t "~&'+nonce+':~D~%" (+ 19 23))','--eval','(sleep 10)']
 env=dict(os.environ,NIZAM_LIVE_OWNER=marker)
 unrelated_argv=[sys.executable,'-c','import time; time.sleep(12)']
 unrelated=subprocess.Popen(unrelated_argv,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,start_new_session=True)
 leader=subprocess.Popen(argv,env=env,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,start_new_session=True)
 child=None; child_token=None; leader_token=process_token(leader.pid)
 print('NATIVE_START',json.dumps({'argv':argv,'pid':leader.pid,'token':leader_token,'sbcl_executable_sha256':hashlib.sha256(Path(executable).read_bytes()).hexdigest(),'spawn_form_sha256':hashlib.sha256(form.encode()).hexdigest(),'unrelated_argv':unrelated_argv,'unrelated_pid':unrelated.pid}),flush=True)
 try:
  wait_for_native(lambda: ready.is_file() and pulse.is_file(),3)
  witness=json.loads(ready.read_text()); child=witness['pid']; child_token=process_token(child)
  assert witness=={'pid':child,'ppid':leader.pid,'pgid':leader.pid,'nonce':nonce,'operation_id':'qualification-group-1'},witness
  assert leader_token and process_token(leader.pid)==leader_token and child_token
  assert live_owned(marker)=={leader.pid:leader_token,child:child_token}
  assert os.getpgid(leader.pid)==os.getpgid(child)==leader.pid and leader.pid!=os.getpgrp()
  before=int(pulse.read_text()); os.kill(child,signal.SIGTERM)
  wait_for_native(lambda: process_token(child)==child_token and int(pulse.read_text())>before)
  print('NATIVE_READY',json.dumps({**witness,'child_token':child_token,'actual_TERM_ignored_with_progress':True}),flush=True)
  before=int(pulse.read_text()); os.killpg(leader.pid,signal.SIGTERM)
  leader.wait(timeout=.25)
  wait_for_native(lambda: process_token(child)==child_token and int(pulse.read_text())>before,.5)
  assert os.getpgid(child)==leader.pid and live_owned(marker).get(child)==child_token
  print('NATIVE_AFTER_GROUP_TERM',json.dumps({'leader_pid':leader.pid,'leader_exit':leader.returncode,'leader_live_token':process_token(leader.pid),'descendant_pid':child,'descendant_still_live_token':process_token(child),'descendant_pgid':os.getpgid(child)}),flush=True)
  os.killpg(leader.pid,signal.SIGKILL)
  wait_for_native(lambda: process_token(child)!=child_token,1)
  out,err=leader.communicate(timeout=.5)
  assert out.decode().splitlines().count(nonce+':42')==1,(out,err)
  assert unrelated.poll() is None and not live_owned(marker)
  elapsed=time.monotonic()-started; assert elapsed<15
  print('NATIVE_RESULT',json.dumps({'result':'PASS native private primitive only','leader_argv':argv,'leader_pid':leader.pid,'leader_exit':leader.returncode,'stdout':out.decode(),'stderr':err.decode(),'descendant_pid':child,'observed_descendant_dead_after_group_KILL':True,'natural_lifetime_seconds':45,'actual_elapsed_seconds':elapsed,'unrelated_pid':unrelated.pid,'unrelated_survived':True,'runtime_controller_or_selector_executed':False}),flush=True)
 finally:
  owned=live_owned(marker)
  if (process_token(leader.pid)==leader_token and os.getpgid(leader.pid)==leader.pid or
      child is not None and owned.get(child)==child_token and os.getpgid(child)==leader.pid):
   try: os.killpg(leader.pid,signal.SIGKILL)
   except ProcessLookupError: pass
  out,err=leader.communicate(timeout=1)
  unrelated.terminate()
  try: uout,uerr=unrelated.communicate(timeout=1)
  except subprocess.TimeoutExpired: unrelated.kill(); uout,uerr=unrelated.communicate(timeout=1)
  print('NATIVE_CLEANUP',json.dumps({'leader_pid':leader.pid,'leader_exit':leader.returncode,'remaining_owned':live_owned(marker),'unrelated_argv':unrelated_argv,'unrelated_pid':unrelated.pid,'unrelated_exit':unrelated.returncode,'stdout':uout.decode(),'stderr':uerr.decode()}),flush=True)
  assert not live_owned(marker)
