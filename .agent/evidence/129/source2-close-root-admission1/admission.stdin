
from pathlib import Path
import json,hashlib,gzip,subprocess
r=Path.cwd();b=r/'.agent/evidence/129/source2-close-diagnostic1';sha=lambda x:hashlib.sha256(x).hexdigest();load=lambda n:json.loads((b/n).read_text());assert sha((b/'report.json').read_bytes())=='31f3aabcb7ccee56cc70d290b5fb0dbb30711b5f25a42ba9fde4600bbe885881' and sha((b/'index.json').read_bytes())=='b90a05151101028388b98579cb3a5057173ce170c69f31d2abbc8d1d82465ac4'
for p,h in load('index.json').items():assert sha((r/p).read_bytes())==h
v=load('report.json');rev='93f8d98df5315f595f72529af866b003b2a81f30';assert v['exercised_revision']==rev
for p,h in v['bindings_sha256'].items():assert sha(subprocess.check_output(['git','show',rev+':'+p]))==h
assert subprocess.check_output(['git','diff','--name-only',v['unchanged_source2_base'],rev]).decode().splitlines()==['.agent/evidence/129/source2-close-diagnostic1/probe.py']
for name,exitcode,pid in [('idle-close',1,4095631),('driver',0,4095537)]:
 f=load(name+'.execution.json');assert f['actual_exit']==exitcode and f['child_pid']==pid and f['exercised_revision']==rev and not f['timed_out']
 for k in ['stdout','stderr']:
  x=(b/Path(f[k]['path']).name).read_bytes();assert sha(x)==f[k]['sha256'] and len(x)==f[k]['bytes']
assert (b/'idle-close.stderr.txt').read_text().strip()=='BEHAVIOR_ASSERTION: OWNED_RUNTIME_GROUP_CLOSE_DEATH_BEYOND_LEADER'
raw=(b/'idle-close.stdout.txt').read_text();obs=[json.loads(x.partition(' ')[2]) for x in raw.splitlines() if x.startswith('IDLE_CLOSE_OBSERVATION ')];assert len(obs)==1 and obs[0]==v['observed_before_fixture_cleanup'];x=obs[0]
assert x['closed_response']=={'ok':True,'result':{'closed':True,'session_id':'live'}} and x['leader_observed_token'] is None and x['descendant_observed_token']==x['descendant_original_token']=='93156704'
assert x['pulse_before_close']<x['pulse_at_response']<x['pulse_after_close'] and x['before_cleanup'] is True and x['since_spawn_seconds']<30<x['backstop_seconds']
s=x['supervisor_lifecycle'];assert s['observed_token'] is None and s['endpoint_exists'] is False and s['supervisor_owns_lock'] is False and s['seconds_since_closed_ack']<x['seconds_since_closed_ack']
assert x['unrelated_alive'] is True and x['sentinel_equal'] is True and x['attempt_equal'] is True
cleanup=[json.loads(x.partition(' ')[2]) for x in raw.splitlines() if x.startswith('IDLE_CLOSE_CLEANUP ')];assert len(cleanup)==1 and cleanup[0]==v['fixture_cleanup_after_decisive_observation'] and cleanup[0]['remaining']=={} and cleanup[0]['attempt_equal'] is True
before=json.loads(gzip.decompress((b/'idle-close.preservation-before.json.gz').read_bytes()));after=json.loads(gzip.decompress((b/'idle-close.preservation-after.json.gz').read_bytes()));assert before==after and before['head']==rev and before['status']=='' and len(before['rows'])==16356 and sum(x['path'].startswith('.nizam/') for x in before['rows'])==239
for p in ['.agent/validator/129-mode-a.json','.agent/qa/129-contract-review.json','.agent/validator/129-postsource-fixture3.json','.agent/validator/129-source3-architecture2.json']:
 gate=json.loads((r/p).read_text());assert gate['final_verdict']['approved'] is True and all(gate[k]==[] for k in ['issues','missing_acceptance_coverage','unsupported_claims'])
assert sha((r/'tools/runtime_session.py').read_bytes())=='fe5917389ee3bdec342bd440d7ce48adf7d7e933cb4cf3f4dc1d1bbb1cecb345' and not (r/'tools/sbcl_session_loop.lisp').exists()
print(json.dumps({'admitted':'actual S1owned descendant survivor after completed publicclose only','selector':1,'driver':0,'supervisor_and_leader_dead':True,'descendant_progress_after_closed':True,'cleanup_separate':True,'installed':239},sort_keys=True))
