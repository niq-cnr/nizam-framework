import hashlib,json,subprocess
from pathlib import Path
rev='b0ca47e8283d94235d7973d191a25b4159e7a4af';prefix='.agent/evidence/129/implementation4/monitor-qualification1/'
read=lambda name:subprocess.check_output(['git','show',rev+':'+prefix+name])
f=json.loads(read('native1.execution.json'));assert f['actual_exit']==0 and f['child_pid']==375064 and not f['timed_out'] and f['exercised_revision']=='31d7f8195d5b73c3a4aa24519bb9f5ebc5365ce0'
for k in ['stdout','stderr']:
 data=read(Path(f[k]['path']).name);assert hashlib.sha256(data).hexdigest()==f[k]['sha256'] and len(data)==f[k]['bytes']
checks=json.loads(read('native1.stdout.txt'))['checks']
assert set(checks)=={'mutation_during_collection','atomic_path_replacement','directory_rename_and_ancestor_coverage','ancestor_replacement_visible','lost_watch_delete_and_ignored','native_queue_overflow_fail_closed_signal','fd_handoff_and_post_death_lifetime'}
print('Seven native primitive observations pinned; actual0 PID375064. Archive retains evidence and ancestry. Product monitor coverage/currentness and independent review remain pending. No runtime rerun.')
