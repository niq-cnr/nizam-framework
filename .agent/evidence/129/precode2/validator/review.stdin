root=Path.cwd();sha=lambda b:hashlib.sha256(b).hexdigest();release='3e2f5c95cd6721fd78e0a53a06c26966d8b044ce';proposal='3bbafe0dae4b2189a8a5bf972ce34037ee5cfb4a';oldproposal='872bb3bb611834d1f3e9ec76b8dc9e8f018aab81';path='.agent/contracts/129.json';raw=(root/path).read_bytes();c=json.loads(raw);assert sha(raw)=='fcebeec5520ea8616e14e8059503358f76c5c91ddfea779041bd4a0a04c8ce85';assert raw==subprocess.check_output(['git','show',proposal+':'+path])
