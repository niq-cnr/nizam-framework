assert b'fixtures/runtime_session/stub_runtime.py' in source and any(isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id=='parse_json' for n in ast.walk(functions['operation_data']))
assert b"'usage': 64" in source and b"result = {'ok': False, 'error': reason}" in source
