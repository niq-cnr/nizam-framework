 b=(r/p).read_bytes();assert hashlib.sha256(b).hexdigest()==h;v=json.loads(b);assert v['final_verdict']['approved'] is True and all(v[k]==[] for k in ['issues','missing_acceptance_coverage','unsupported_claims'])
for p,h in [('.agent/evidence/129/implementation4/architecture-preparation1.json','a3d9831d2e5fc65c8bb523b9b2c5fe87a7a84060bd3510643fbe0bd9e52cbdc0'),('.agent/evidence/129/source3-semantic-diagnostics1/probe.py','f5b4184aa275058436abb7290dacdf396f16597777b6ee37cb3b445a549486bc'),('.agent/evidence/129/source3-semantic-diagnostics1/intent.json','7ffe78852566c5540e313839548c515a59a71e86c33bbf04d6bb5a49d3761ff4')]:assert hashlib.sha256((r/p).read_bytes()).hexdigest()==h,p
