from pathlib import Path
import hashlib,json,subprocess
rev="fde4115b4468b7b9da412b1078294345a4f4a442"
def blob(path): return subprocess.check_output(["git","show",rev+":"+path])
def sha(raw): return hashlib.sha256(raw).hexdigest()
for path,want in {"tools/runtime_session.py":"aae6a5cbe09435e39c29153469a9ca13f45065e6248ff70ca44f6ce9bc5d8fa5","tools/sbcl_session_loop.lisp":"2ad3d3b633637e305e428169654929aec80577f55d90477338071247cb5f0cf9","tools/test_runtime_session.py":"d186e915424040b32ee9c232d952a170ec0a806cf415126abf34a8a81eda0431",".agent/contracts/129.json":"71c6374a6bd88a1110de3fceb612a1392f0b203736e13843caace9fec52c26e6"}.items():
 actual=sha(blob(path));assert actual==want;print(json.dumps({"revision":rev,"path":path,"sha256":actual}))
base=Path(".agent/evidence/129/source2-regression-red1");index=json.loads((base/"index.json").read_text())
for path,want in index.items(): assert sha(Path(path).read_bytes())==want
print(json.dumps({"raw_index":str(base/"index.json"),"sha256":sha((base/"index.json").read_bytes()),"verified_entries":len(index)}))
for name in ("admission","group-death"):
 frame=json.loads((base/(name+".execution.json")).read_text());driver=json.loads((base/(name+"-driver.execution.json")).read_text());assert frame["exercised_revision"]==rev
 for channel in ("stdout","stderr"): assert sha((base/(name+"."+channel+".txt")).read_bytes())==frame[channel]["sha256"]
 print(json.dumps({"selector":name,"actual_exit":frame["actual_exit"],"pid":frame["child_pid"],"driver_actual_exit":driver["actual_exit"],"driver_pid":driver["child_pid"],"revision":frame["exercised_revision"]}))
raw=(base/"group-death.stdout.txt").read_text().splitlines();parsed=0;other=[]
for number,line in enumerate(raw,1):
 if line.startswith(("LIVE_GROUP_DESCENDANT ","LIVE_NEGATIVE_CONTROL ","PASS ")): print(f"RAW {base}/group-death.stdout.txt:{number}: {line}")
 if line.startswith("LIVE_COMMAND "):
  event=json.loads(line[len("LIVE_COMMAND "):]);argv=event["argv"]
  if len(argv)<2 or Path(argv[1]).name!="runtime_session.py":
   other.append({"line":number,"argv":argv,"exit":event["exit"],"stdout_sha256":sha(event["stdout"].encode())});continue
  response=json.loads(event["stdout"]);parsed+=1
  value=response.get("result",{})
  if argv[2] in ("cancel-operation","close-session") or isinstance(value,dict) and value.get("status")=="terminated":
   print(json.dumps({"raw_line":number,"action":argv[2],"actual_exit":event["exit"],"status":value.get("status"),"closed":value.get("closed"),"operation_id":value.get("operation_id"),"child_pid":event["pid"]}))
print(json.dumps({"parsed_public_cli_records":parsed,"non_cli_observations":other}))
for path,ranges in [("tools/runtime_session.py",[(702,722),(898,913),(984,1003),(1013,1021)]),("tools/test_runtime_session.py",[(1829,1863),(1920,1949)])]:
 lines=blob(path).decode().splitlines()
 for start,end in ranges:
  for number in range(start,end+1): print(f"SOURCE {rev}:{path}:{number}: {lines[number-1]}")
frame=json.loads(Path(".agent/evidence/129/source2-regression-root-admission1/admission.execution.json").read_text());assert frame["actual_exit"]==0
print(json.dumps({"root_admission_actual_exit":frame["actual_exit"],"root_admission_pid":frame["child_pid"]}))
print("STATIC_ONLY: no runtime/probe/test/product import or fixture modification; no signal chronology inferred")
