import ast,hashlib,json,subprocess,jsonschema
from pathlib import Path
root=Path.cwd();sha=lambda b:hashlib.sha256(b).hexdigest();proposal='872bb3bb611834d1f3e9ec76b8dc9e8f018aab81';cp='.agent/contracts/129.json';raw=(root/cp).read_bytes();c=json.loads(raw);assert sha(raw)=='4ac4353b7087336b86fab01baf5ba04c28e4260cb40f43849aec270a4901844f'
