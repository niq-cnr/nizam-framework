f=json.loads((root/'.agent/feature_list_020.json').read_bytes());feature=next(x for x in f['features'] if x['id']=='129');assert [v['command'] for v in c['verification'][:7]]==feature['acceptance_tests'];assert [v['command'] for v in c['verification'][7:]]==['PYTHONDONTWRITEBYTECODE=1 python3 tools/test_runtime_session.py --check core-ready','bash tools/validate.sh','bash tools/validate.sh --payload']
source=(root/'tools/runtime_session.py').read_bytes();tree=ast.parse(source);functions={n.name:n for n in tree.body if isinstance(n,ast.FunctionDef)};v=functions['validate_request'];branch=v.body[0];call=next(n for n in ast.walk(branch.body[1]) if isinstance(n,ast.Call));optional=ast.literal_eval(call.args[2]);assert optional=={'expected_generation','expected_lease_epoch'} and 'runtime' not in optional
assert any(isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id=='parse_json' for n in ast.walk(functions['operation_data']))
assert not (root/'tools/sbcl_session_loop.lisp').exists();assert b'fixtures/runtime_session/stub_runtime.py' in source
runner=ast.parse((root/'tools/test_runtime_session.py').read_bytes());runtime_call=next(n for n in ast.walk(runner) if isinstance(n,ast.Call) and n.args and isinstance(n.args[0],ast.Constant) and n.args[0].value=='--runtime');assert next(ast.literal_eval(k.value) for k in runtime_call.keywords if k.arg=='choices')==('stub',)
operation=json.loads((root/'schema/runtime_operation.schema.json').read_bytes());session=json.loads((root/'schema/runtime_session.schema.json').read_bytes());assert operation['additionalProperties'] is False and session['additionalProperties'] is False;assert all(k in operation['properties'] for k in ('condition_ref','condition_capture','cancellation_confirmed'));assert operation['$defs']['payload']['properties']['expression']['type']=='string'
