release=json.loads(subprocess.check_output(['git','show','a6ddbee2cef7097b1b6747017d987b4f1aec24e7:.agent/run_state.json']));counter=release['circuit_breaker']['129-precode'];assert counter['attempts']==1 and counter['proposal_revision']==proposal and counter['proposal_sha256']==sha(raw)
