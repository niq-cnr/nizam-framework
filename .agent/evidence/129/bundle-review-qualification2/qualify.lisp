(in-package :cl-user)
(defun qualify-read (row)
  (let ((*read-eval* nil) (end (list :end)) (count 0))
    (with-open-file (stream (getf row :path))
      (loop for form = (read stream nil end) until (eq form end) do (incf count)))
    (assert (plusp count))
    (format t "~&FIXTURE_READ ~A ~D~%" (getf row :label) count)))

(defun qualify-active (row)
  (let ((captures 0) (kind (getf row :kind))
        (*print-level* 6) (*print-length* 32) (*print-circle* t))
    (catch 'qualified-stop
      (handler-bind
          ((error (lambda (condition)
                    (assert (string= (symbol-name (type-of condition)) (getf row :condition)))
                    (let ((restart (find-restart (intern (getf row :restart) :cl-user) condition))
                          (frames (with-output-to-string (stream)
                                    (sb-debug:print-backtrace :count 64 :stream stream))))
                      (assert restart)
                      (assert (search (getf row :frame) frames :test #'char-equal))
                      (incf captures)
                      (format t "~&ACTIVE_CAPTURE ~A ~A ~A ~A~%"
                              (getf row :label) (type-of condition) (getf row :frame) (restart-name restart))
                      (when (getf row :render)
                        (let ((text (with-output-to-string (stream) (princ condition stream))))
                          (format t "~&REPORT_TEXT ~A ~A~%" (getf row :label) text))))
                    (throw 'qualified-stop t))))
        (if (string= kind "compile_source")
            (compile-file (getf row :path))
            (load (getf row :path) :verbose nil :print nil))))
    (assert (plusp captures))
    (dolist (key '(:progress :cleanup))
      (with-open-file (stream (getf row key))
        (assert (equal (read-line stream nil nil) (getf row :witness)))
        (assert (null (read-line stream nil nil)))))
    (assert (not (probe-file (getf row :invoked))))
    (assert (probe-file (getf row :ended)))
    (when (getf row :render) (assert (probe-file (getf row :callback))))
    (format t "~&ACTIVE_DONE ~A ~D~%" (getf row :label) captures)))

(let* ((manifest (merge-pathnames "manifest.lisp" *load-truename*))
       (rows (let ((*read-eval* nil)) (with-open-file (stream manifest) (read stream)))))
  (assert (= (length rows) 14))
  (dolist (row rows) (qualify-read row))
  (dolist (row rows) (when (getf row :active) (qualify-active row)))
  (format t "~&QUALIFICATION_DONE READ=14 ACTIVE=6~%"))
