from pathlib import Path
import json,hashlib,gzip,shlex,subprocess
r=Path.cwd();d=r/'.agent/evidence/129/implementation3/environment-continuation1';old=r/'.agent/evidence/129/implementation3/validation1'
h=lambda b:hashlib.sha256(b).hexdigest()
idx=json.loads((d/'raw-index.json').read_text())
for p,row in idx.items():
 b=(d/p).read_bytes();assert h(b)==row['sha256'] and len(b)==row['bytes'],p
receipt=json.loads((d/'receipt.json').read_text());candidate='0697bfe5e121543b2aa8ed8c8607d0c50e99b413'
assert receipt['first_capture_and_all_exercised_revisions']==candidate
for p,digest in receipt['source_bindings'].items():assert h(subprocess.check_output(['git','show',candidate+':'+p]))==digest,p
contract=json.loads((r/'.agent/contracts/129.json').read_text());required={tuple(shlex.split(x['command'])[1:]) for x in contract['verification']};seen=set()
records=[(old,n) for n in ['admission','capture','termination','idle-close']]+[(d,x['name']) for x in receipt['continuation_results']]
assert len(records)==12
for base,name in records:
 f=json.loads((base/(name+'.execution.json')).read_text());summary=json.loads((base/(name+'.capture-summary.json')).read_text())
 assert f['actual_exit']==0 and f['exercised_revision']==candidate and not f['timed_out']
 for k in ['stdout','stderr']:
  b=(base/Path(f[k]['path']).name).read_bytes();assert h(b)==f[k]['sha256'] and len(b)==f[k]['bytes']
 a=json.loads(gzip.decompress((base/(name+'.preservation-before.json.gz')).read_bytes()));b=json.loads(gzip.decompress((base/(name+'.preservation-after.json.gz')).read_bytes()))
 assert a==b and summary['success'] and summary['preservation_equal']
 assert len(a['rows'])==16455 and sum(x['path'].startswith('.nizam/') for x in a['rows'])==239
 rows={x['path']:x for x in a['rows']}
 for p,digest in receipt['source_bindings'].items():assert rows[p]['sha256']==digest,(name,p)
 argv=f['argv']
 if base==d:assert argv[:2]==['env','TMPDIR=/tmp'];argv=argv[2:]
 if name!='idle-close':seen.add(tuple(argv))
 print('PASS',name,'actual0/PID',f['child_pid'],'all16455/239 equal')
assert seen==required,(seen,required)
for x in receipt['retained_prior_results']:assert h((r/x['frame']).read_bytes())==x['frame_sha256']
original=json.loads((old/'printing.execution.json').read_text());assert original['actual_exit']==2 and original['child_pid']==4147568
assert h((r/'tools/runtime_session.py').read_bytes())=='fe5917389ee3bdec342bd440d7ce48adf7d7e933cb4cf3f4dc1d1bbb1cecb345' and not (r/'tools/sbcl_session_loop.lisp').exists()
print('PASS exact all11 coverage plus sealedcloseextra; originalprinting2 retained; Generator verification only, not ModeB/QA/budget/readiness')
