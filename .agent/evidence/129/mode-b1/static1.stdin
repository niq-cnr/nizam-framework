import ast, hashlib, json, subprocess
from pathlib import Path
ROOT=Path.cwd(); C='0697bfe5e121543b2aa8ed8c8607d0c50e99b413'; BASE='7257e43dce83d93e9498ba8c676aedd79d6ac83b'
def git(*args): return subprocess.check_output(['git',*args])
def blob(p,ref=C): return git('show',ref+':'+p)
def sha(raw): return hashlib.sha256(raw).hexdigest()
pins={'tools/runtime_session.py':'e8e5571d365d8bf84df34c0bac1a08b002297543100f1fd6e33c9e6c046712ce','tools/sbcl_session_loop.lisp':'2ad3d3b633637e305e428169654929aec80577f55d90477338071247cb5f0cf9','tools/test_runtime_session.py':'d186e915424040b32ee9c232d952a170ec0a806cf415126abf34a8a81eda0431','.agent/contracts/129.json':'71c6374a6bd88a1110de3fceb612a1392f0b203736e13843caace9fec52c26e6'}
assert git('rev-parse','HEAD').decode().strip()=='e68cc9e0f9e04059ffbe0cc96f659af27ba851ce'
for p,h in pins.items(): assert sha(blob(p))==h
print('EXACT_CANDIDATE_PINS',json.dumps(pins,sort_keys=True))
assert sha((ROOT/'tools/runtime_session.py').read_bytes())=='fe5917389ee3bdec342bd440d7ce48adf7d7e933cb4cf3f4dc1d1bbb1cecb345'
assert not (ROOT/'tools/sbcl_session_loop.lisp').exists()
assert git('diff','--name-only',C,'HEAD','--','.nizam/')==b''
print('ROOT_BASELINE_DISTINCT_FROM_REVIEWED_CANDIDATE; INSTALLED_DIFF_EMPTY')
original=blob('.agent/evidence/129/source2-close-diagnostic1/probe.py'); binding=json.loads(blob('.agent/evidence/129/implementation3-close-probe1/binding.json'))
assert sha(original)==binding['original_sha256']=='c88dd71e20ecd1006b8c07c1f5025815c9dca168006fb75a2ea2df54bbb5beaa'
derived=original
for p,row in binding['bindings'].items():
 assert original.count(row['old'].encode())==1
 assert row['new']==pins[p]
 derived=derived.replace(row['old'].encode(),row['new'].encode())
assert derived==blob('.agent/evidence/129/implementation3-close-probe1/probe.py')
assert sha(derived)==binding['derived_sha256']
print('SEALED_PROBE_ONLY_APPROVED_DIGEST_REPLACEMENTS',json.dumps(binding,sort_keys=True))
for p in ('.agent/validator/129-mode-a.json','.agent/qa/129-contract-review.json','.agent/validator/129-source3-architecture2.json','.agent/validator/129-source3-environment1.json'):
 x=json.loads((ROOT/p).read_bytes()); assert x['final_verdict']['approved'] is True and all(x[k]==[] for k in ('issues','missing_acceptance_coverage','unsupported_claims'))
 print('PREVIOUS_GATE',p,sha((ROOT/p).read_bytes()))
review=json.loads((ROOT/'.agent/validator/129-source3-architecture2.json').read_bytes())
assert '10ee9b2406df5141b2aed9aaa1a022416ad74117' in review['provenance_erratum']['independent_resolution']
print('ARCHITECTURE_ERRATUM',json.dumps(review['provenance_erratum'],sort_keys=True))
for rev in ('ee1ce1dfb6b0f235c23eae439e00328645098c42','2e8c92d11c36525c3b73b8cfb23822c4507835cb','a9114bcbe16fba76dbdba1147ea76db8a5a6b39d'):
 print('SOURCE_COMMIT',rev,git('diff-tree','--no-commit-id','--name-only','-r',rev).decode())
text=blob('tools/runtime_session.py').decode(); tree=ast.parse(text)
print('STATIC_ONLY_NO_PRODUCT_IMPORT_OR_EXECUTION')
for lo,hi in ((1144,1147),(1208,1216),(1250,1260),(1296,1302),(1308,1326),(1430,1467)):
 print('REVIEWED_SOURCE_LINES',lo,hi)
 for n,line in enumerate(text.splitlines(),1):
  if lo<=n<=hi: print(str(n)+':'+line)
print('FULL_PRODUCT_AND_ACCEPTANCE_DIFF')
print(git('diff',BASE,C,'--','tools/runtime_session.py','tools/sbcl_session_loop.lisp','tools/test_runtime_session.py').decode())
print('ALL_DELTA_PATHS')
print(git('diff','--name-status',BASE,C).decode())
