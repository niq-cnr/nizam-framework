from pathlib import Path
import ast,hashlib,importlib.util,json,subprocess,tempfile
root=Path.cwd();p=root/'tools/test_runtime_session.py';raw=p.read_bytes();original=subprocess.check_output(['git','show','d66ff730248dec4f086365be55eb4ad060a350c5:tools/test_runtime_session.py'])
compile(raw,str(p),'exec')
new=ast.parse(raw);old=ast.parse(original)
for node in old.body:
 if isinstance(node,(ast.FunctionDef,ast.ClassDef)):
  found=next(n for n in new.body if isinstance(n,type(node)) and n.name==node.name)
  assert ast.dump(node)==ast.dump(found),node.name
for name in ['CORE_LEAVES','CHECKS','CASES']:
 def assignment(tree): return next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id==name for t in n.targets))
 assert ast.dump(assignment(old))==ast.dump(assignment(new)),name
assert hashlib.sha256((root/'.agent/contracts/129.json').read_bytes()).hexdigest()=='71c6374a6bd88a1110de3fceb612a1392f0b203736e13843caace9fec52c26e6'
assert not (root/'tools/sbcl_session_loop.lisp').exists()
print('DEVELOPMENT_ONLY syntax and inherited function/class/CORE14/CHECKS/CASES preservation PASS')
print('RUNNER_SHA256',hashlib.sha256(raw).hexdigest())
s=importlib.util.spec_from_file_location('acceptance',p);module=importlib.util.module_from_spec(s);s.loader.exec_module(module)
with tempfile.TemporaryDirectory(prefix='n129-direct-preflight-') as temp: module.sbcl_preflight(Path(temp))
print('DEVELOPMENT_ONLY real direct SBCL dependency preflight PASS; no controller/SBCL backend acceptance executed')
