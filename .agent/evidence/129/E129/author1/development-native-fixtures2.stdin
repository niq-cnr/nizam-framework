from pathlib import Path
import ast,hashlib,importlib.util,json,os,re,shutil,subprocess,tempfile
root=Path.cwd();p=root/'tools/test_runtime_session.py';raw=p.read_bytes();compile(raw,str(p),'exec')
old=ast.parse(subprocess.check_output(['git','show','d66ff730248dec4f086365be55eb4ad060a350c5:tools/test_runtime_session.py']));new=ast.parse(raw)
for n in old.body:
 if isinstance(n,(ast.FunctionDef,ast.ClassDef)):
  assert ast.dump(n)==ast.dump(next(v for v in new.body if type(v) is type(n) and v.name==n.name)),n.name
for name in ['CHECKS','CASES','CORE_LEAVES']:
 def find(t):return next(n for n in t.body if isinstance(n,ast.Assign) and any(isinstance(v,ast.Name) and v.id==name for v in n.targets))
 assert ast.dump(find(old))==ast.dump(find(new)),name
assert hashlib.sha256((root/'.agent/evidence/129/interface-intent1.json').read_bytes()).hexdigest()=='402e7d02486f7ff29697433c13d05d9d86b691c67eba2310a24bc0817cbbf773'
s=importlib.util.spec_from_file_location('acceptance',p);a=importlib.util.module_from_spec(s);s.loader.exec_module(a)
executable=str(Path(shutil.which('sbcl')).resolve());reports=ast.literal_eval(next(n for n in new.body if isinstance(n,ast.FunctionDef) and n.name=='live_printing').body[0].value)
assert len(a.LIVE_CHECKS)==5
with tempfile.TemporaryDirectory(prefix='n129-native-fixtures-') as temp:
 home=Path(temp);session=a.LiveSession(home);session.record={'owner':a.OWNER,'generation':{'counter':1,'nonce':'0'*32},'lease_epoch':0}
 sources=[]
 for i,(report,limits) in enumerate(reports):
  request,*_=a.condition_fixture(session,report=report);path=home/f'report{i}.lisp';path.write_text(request['payload']['expression']);sources.append(path)
 for kind in ['evaluate','load_source','compile_source']:
  request,*_=a.condition_fixture(session,kind=kind);path=home/(kind+'.lisp');path.write_text(request['payload']['expression']);sources.append(path)
 paths=' '.join(json.dumps(str(p)) for p in sources)
 form='(let ((*read-eval* nil)) (dolist (path (quote ('+paths+'))) (with-open-file (s path) (loop for x = (read s nil :eof) until (eq x :eof))) (format t "~&DIRECT_FIXTURE_READ_OK~%")))'
 depth=0; quoted=False; escaped=False
 for char in form:
  if quoted:
   if escaped: escaped=False
   elif char==chr(92): escaped=True
   elif char=='"': quoted=False
  elif char=='"': quoted=True
  elif char=='(': depth+=1
  elif char==')': depth-=1; assert depth>=0
 assert depth==0 and not quoted
 guard='(let ((*read-eval* nil)) (multiple-value-bind (obj position) (read-from-string '+json.dumps(form)+') (declare (ignore obj)) (unless (= position '+str(len(form))+') (error "unread auxiliary tail")) (write-line "AUXILIARY_WRAPPER_READ_OK")))'
 rc,out,err=a.live_process([executable,'--noinform','--no-sysinit','--no-userinit','--non-interactive','--eval',guard],home,dict(os.environ));assert rc==0 and out.splitlines().count('AUXILIARY_WRAPPER_READ_OK')==1
 print('STRUCTURAL_RECOVERY_RELEASE abd6dd7f2ebe5765095b59ea174db5ac117163d8 attempt2/3; original EOF failure retained; no product edit')
 rc,out,err=a.live_process([executable,'--noinform','--no-sysinit','--no-userinit','--non-interactive','--eval',form],home,dict(os.environ));assert rc==0 and out.splitlines().count('DIRECT_FIXTURE_READ_OK')==1
 for kind in ['evaluate','compile_source']:
  request,progress,cleanup,invoked,witness,names=a.condition_fixture(session,kind=kind);path=home/(kind+'-active.lisp');path.write_text(request['payload']['expression'])
  operation='('+('compile-file' if kind=='compile_source' else 'load')+' '+json.dumps(str(path))+')'
  handler='(lambda (c) (when (and (eq (type-of c) (quote '+names[0]+')) (find-restart (quote '+names[2]+') c)) (format t "~&DIRECT_CAPTURE_OK~%") (sb-debug:print-backtrace :count 64 :stream *standard-output*)))'
  form='(handler-case (handler-bind ((error '+handler+')) '+operation+') (error (c) (declare (ignore c)) nil))'
  rc,out,err=a.live_process([executable,'--noinform','--no-sysinit','--no-userinit','--non-interactive','--eval',form],home,dict(os.environ));assert rc==0 and out.splitlines().count('DIRECT_CAPTURE_OK')==1
  assert names[1] in [x.rsplit(':',1)[-1] for x in re.findall(r'[A-Z0-9_:+*/<>=!?-]+',out)]
  assert progress.read_text().splitlines()==[witness] and cleanup.read_text().splitlines()==[witness] and not invoked.exists()
  print('DIRECT_NATIVE_FIXTURE_PASS',kind,names,hashlib.sha256(path.read_bytes()).hexdigest())
 print('DIRECT_NATIVE_ONLY conditions/restarts/backtrace/partial compile/load fixture controls; no controller/backend runtime was started')
print('STATIC_PRESERVATION_PASS original functions/classes/CHECKS/CASES/CORE14 unchanged')
print('FINAL_PROPOSED_RUNNER_SHA256',hashlib.sha256(raw).hexdigest())
print('SOURCE_ABSENT',not (root/'tools/sbcl_session_loop.lisp').exists())
