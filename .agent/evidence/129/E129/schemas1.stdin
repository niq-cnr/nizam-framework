from pathlib import Path
import json,hashlib,subprocess
import jsonschema
root=Path.cwd();p=root/'.agent/qa/129-contract-review.json';v=json.loads(p.read_text())
for rel in ['schema/contract_review.schema.json','.nizam/schema/contract_review.schema.json']:
 jsonschema.Draft202012Validator(json.loads((root/rel).read_text())).validate(v)
 print('VERDICT_SCHEMA_PASS',rel)
assert v['feature']==v['final_verdict']['feature']=='129'
assert v['final_verdict']['approved'] is False and len(v['issues'])==1
assert v['missing_acceptance_coverage']==[] and v['unsupported_claims']==[]
assert subprocess.check_output(['git','diff','--name-only','HEAD']).strip()==b''
paths=subprocess.check_output(['git','ls-files','--others','--exclude-standard','-z']).decode().split('\0')
assert all(not p or p=='.agent/qa/129-contract-review.json' or p.startswith('.agent/evidence/129/E129/') for p in paths)
for path,pin in v['inputs'].items():
 assert hashlib.sha256((root/path).read_bytes()).hexdigest()==pin['sha256'],path
print('VERDICT_SHA256',hashlib.sha256(p.read_bytes()).hexdigest())
print('STRICT_AGF_GATE rejection; approved=false; issues=1; missing_acceptance_coverage=0; unsupported_claims=0')
print('SCOPE_PASS only own review and E129 evidence; tracked product, Source, tests, CI, installed payload, phase and Rootstate unchanged')
print('STATIC_ONLY no acceptance, runtime, Source, installation, allocation or activation work')
