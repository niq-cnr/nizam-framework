
from pathlib import Path
import json,hashlib
r=Path.cwd();b=r/'.agent/evidence/129/source2-recovery3';v=json.loads((r/'.agent/validator/129-source2-recovery3.json').read_text());assert v['final_verdict']['approved'] is True and all(v[k]==[] for k in ['issues','missing_acceptance_coverage','unsupported_claims'])
assert 'diagnostic assessment only' in v['approval_scope']
for n,row in json.loads((b/'index.json').read_text()).items():
