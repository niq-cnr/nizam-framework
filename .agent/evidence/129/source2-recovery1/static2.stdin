from pathlib import Path
import json,hashlib,subprocess
rev="f9fe6d441a94a94798bd42071827b4f2d264be49"
def blob(path):
 return subprocess.check_output(["git","show",rev+":"+path])
def digest(raw): return hashlib.sha256(raw).hexdigest()
expected={"tools/runtime_session.py":"aae6a5cbe09435e39c29153469a9ca13f45065e6248ff70ca44f6ce9bc5d8fa5","tools/sbcl_session_loop.lisp":"2ad3d3b633637e305e428169654929aec80577f55d90477338071247cb5f0cf9","tools/test_runtime_session.py":"a61a2ec17e729a6c6ea0b9090a639beb0903db49c4d9869b948d908d568bdf1e"}
for path,want in expected.items():
 raw=blob(path);assert digest(raw)==want
 print(json.dumps({"candidate":rev,"path":path,"sha256":digest(raw),"lines":len(raw.splitlines())}))
frozen=json.loads(Path(".agent/evidence/129/frozen-bundle2.json").read_text())
identity=digest(json.dumps(frozen["bundle"],sort_keys=True,separators=(",",":")).encode())
assert identity==frozen["bundle_identity_sha256"]
for key,path in [("contract_sha256",".agent/contracts/129.json"),("interface_sha256",".agent/evidence/129/interface-intent1.json")]:
 assert digest(blob(path))==frozen["bundle"][key]
print(json.dumps({"bundle_identity":identity,"contract_and_interface_hashes_verified":True}))
base=Path(".agent/evidence/129/implementation2/public-validation2")
index=json.loads((base/"raw-index.json").read_text())
for name,entry in index.items():
 raw=(base/name).read_bytes();assert digest(raw)==entry["sha256"] and len(raw)==entry["bytes"]
print(json.dumps({"raw_index":str(base/"raw-index.json"),"sha256":digest((base/"raw-index.json").read_bytes()),"verified_entries":len(index)}))
for name in ("admission","capture","printing"):
 frame=json.loads((base/(name+".execution.json")).read_text());assert frame["exercised_revision"]==rev
 for stream in ("stdout","stderr"):
  assert digest((base/(name+"."+stream+".txt")).read_bytes())==frame[stream]["sha256"]
 print(json.dumps({"execution":str(base/(name+".execution.json")),"actual_exit":frame["actual_exit"],"exercised_revision":frame["exercised_revision"]}))
non_cli=[]; parsed_cli=0; candidate_errors=[]
for n,line in enumerate((base/"printing.stdout.txt").read_text().splitlines(),1):
 if line.startswith("LIVE_COMMAND "):
  v=json.loads(line[len("LIVE_COMMAND "):])
  if len(v["argv"])<2 or Path(v["argv"][1]).name!="runtime_session.py":
   non_cli.append({"line":n,"argv":v["argv"],"exit":v["exit"],"stdout_bytes":len(v["stdout"].encode()),"stdout_sha256":digest(v["stdout"].encode())})
   continue
  response=json.loads(v["stdout"]);parsed_cli+=1
  if not response.get("ok"): candidate_errors.append({"line":n,"exit":v["exit"],"error":response.get("error")})
  if response.get("error")=="inconsistent_image":
   print(json.dumps({"raw_path":str(base/"printing.stdout.txt"),"line":n,"actual_cli_exit":v["exit"],"operation_id":response["result"]["operation_id"],"rejection":response["error"]}))
print(json.dumps({"parsed_public_cli_records":parsed_cli,"all_candidate_error_records_parsed":candidate_errors,"other_command_observations":non_cli}))
for path,ranges in [("tools/test_runtime_session.py",[(1798,1826),(1994,2017),(2281,2281),(2299,2301)]),("tools/runtime_session.py",[(724,733),(759,760),(837,840),(962,966),(984,1003)]),("tools/sbcl_session_loop.lisp",[(210,220),(228,233),(235,249)])]:
 lines=blob(path).decode().splitlines()
 for start,end in ranges:
  print(f"SOURCE {rev}:{path}:{start}-{end}")
  for n in range(start,end+1): print(f"{n}: {lines[n-1]}")
print("STATIC_ONLY: no product import, runtime, acceptance, mutation candidate or diagnostic rerun")
