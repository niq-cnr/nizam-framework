from pathlib import Path
import json,hashlib,subprocess
r=Path.cwd()
cases=[('.agent/evidence/phase020-accounting-method-review2','.agent/validator/020-accounting-method2.json','static2',4175746),('.agent/evidence/129/source3-environment-diagnosis1','.agent/validator/129-source3-environment1.json','static3',4177117)]
for directory,report,name,pid in cases:
 d=r/directory;i=json.loads((d/'index.json').read_text());i=i.get('files',i)
 for p,row in i.items():
  b=(r/p).read_bytes();h=row if isinstance(row,str) else row['sha256'];assert hashlib.sha256(b).hexdigest()==h,p
  if isinstance(row,dict):assert len(b)==row['bytes'],p
 v=json.loads((r/report).read_text());assert v['final_verdict']['approved'] is True
 assert all(v[k]==[] for k in ['issues','missing_acceptance_coverage','unsupported_claims'])
 f=json.loads((d/(name+'.execution.json')).read_text());assert f['actual_exit']==0 and f['child_pid']==pid and not f['timed_out']
 for stream in ['stdin','stdout','stderr']:
  x=f[stream];b=(d/Path(x['path']).name).read_bytes();assert hashlib.sha256(b).hexdigest()==x['sha256'] and len(b)==x['bytes']
 print('PASS scoped review',report,'actual0/PID',pid)
assert hashlib.sha256((r/'tools/test_runtime_session.py').read_bytes()).hexdigest()=='d186e915424040b32ee9c232d952a170ec0a806cf415126abf34a8a81eda0431'
for p,h in [('tools/runtime_session.py','e8e5571d365d8bf84df34c0bac1a08b002297543100f1fd6e33c9e6c046712ce'),('tools/sbcl_session_loop.lisp','2ad3d3b633637e305e428169654929aec80577f55d90477338071247cb5f0cf9')]:
 b=subprocess.check_output(['git','show','0697bfe5e121543b2aa8ed8c8607d0c50e99b413:'+p]);assert hashlib.sha256(b).hexdigest()==h
print('PASS narrow environment eligibility and held accounting method suitability; no product/QA/budget approval')
