import ast, hashlib, json, subprocess, tempfile
from pathlib import Path
from types import SimpleNamespace
base='2773c56028b5824b6f45726246f55eb50690934e'
runner='tools/test_runtime_session.py'
def git(*args): return subprocess.check_output(['git', *args])
def sha(raw): return hashlib.sha256(raw).hexdigest()
old=git('show', base+':'+runner); new=Path(runner).read_bytes()
a=b"            release = stub.home / 'release-stub'\n"
b=b"            release = stub.state / 'release-stub'\n"
assert sha(old)=='81a7299120ad79cca1765e6c4c47f0d8907bfa6e593804a9ffd97210700dffe4'
assert old.count(a)==1 and new==old.replace(a,b,1)
assert new==git('show','HEAD:'+runner)
assert ast.dump(ast.parse(new))==ast.dump(ast.parse(old.replace(a,b,1)))
changed=git('diff','--name-only',base,'HEAD').decode().splitlines()
assert changed==[runner], changed
status=git('status','--porcelain','--untracked-files=all').decode().splitlines()
assert all(row.startswith('?? .agent/evidence/129/fixture-correction1/') for row in status), status
pins={
 'tools/runtime_session.py':'fe5917389ee3bdec342bd440d7ce48adf7d7e933cb4cf3f4dc1d1bbb1cecb345',
 '.agent/contracts/129.json':'71c6374a6bd88a1110de3fceb612a1392f0b203736e13843caace9fec52c26e6',
 '.agent/evidence/129/interface-intent1.json':'402e7d02486f7ff29697433c13d05d9d86b691c67eba2310a24bc0817cbbf773',
 '.agent/validator/129-postsource-fixture1.json':'6bd2fb2b298ccb007ac59bf2f757fa931dc3e2eb4bfaf7d016d70614be87da0a',
 '.agent/validator/129-bundle-api3.json':'3a00313077b0270efe86ece37c7f292bb4b83b1d36d68407a31fde9a465948c0'}
for path, expected in pins.items(): assert sha(Path(path).read_bytes())==expected, path
assert json.loads(Path('.agent/contracts/129.json').read_text())['status']=='approved'
assert not Path('tools/sbcl_session_loop.lisp').exists()
installed=git('ls-files','-z','.nizam').split(b'\0')[:-1]
assert len(installed)==239
for raw in installed:
 path=raw.decode(); assert Path(path).read_bytes()==git('show',base+':'+path), path
freeze=json.loads(Path('.agent/evidence/129/frozen-bundle1.json').read_text())
assert freeze['bundle']['runner_sha256']==sha(old)
source=ast.parse(Path('tools/runtime_session.py').read_bytes())
predicate='release.is_absolute() and release.resolve().is_relative_to(self.root)'
guards=[n.args[0] for n in ast.walk(source) if isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id=='insist' and n.args and ast.unparse(n.args[0])==predicate]
assert len(guards)==1
with tempfile.TemporaryDirectory(prefix='n129-path-mechanics-') as temp:
 home=Path(temp); state=home/'state'; state.mkdir()
 fixture=SimpleNamespace(home=home,state=state)
 paths=[eval(compile(ast.parse(line.strip().decode().split(' = ',1)[1],mode='eval'),'<fixture-path>','eval'),{'stub':fixture}) for line in (a,b)]
 check=compile(ast.Expression(guards[0]),'<unchanged-product-predicate>','eval')
 outcomes=[eval(check,{'release':release,'self':SimpleNamespace(root=state)}) for release in paths]
 assert outcomes==[False,True], outcomes
 print(json.dumps({'path_mechanics':{'old':str(paths[0]),'new':str(paths[1]),'root':str(state),'predicate_results':outcomes}}))
print(git('diff','--no-ext-diff','--unified=3',base,'HEAD','--',runner).decode(),end='')
print(json.dumps({'result':'PASS static only','revision':git('rev-parse','HEAD').decode().strip(),'runner_sha256':sha(new),'runner_git_blob':git('rev-parse','HEAD:'+runner).decode().strip(),'exact_one_line_change':True,'ast_parse':True,'unchanged_pins':pins,'installed_files_verified':len(installed),'product_backend_absent':True,'runtime_or_backend_tests_executed':False},sort_keys=True))
