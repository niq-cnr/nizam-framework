import ast,hashlib,json,pathlib
p=pathlib.Path('.agent/evidence/phase020-closed-candidate-inventory1');v=json.loads((p/'preparation.json').read_text());source=(p/'assemble.py').read_bytes();ast.parse(source);assert hashlib.sha256(source).hexdigest()==v['assembler_sha256']
