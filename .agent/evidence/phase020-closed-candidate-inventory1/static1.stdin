assert v['no_numeric_or_runtime_execution'] and v['pending']
assert not (p/'inventory.json.gz').exists()
print('PASS static syntax and exact input/helper pins; no assembler/count/adapter main or runtime executed. Inventory, END/heads, snapshot/tail/merge and exact review remain pending.')
