refs=[]
def walk(x):
 if isinstance(x,dict):
  if all(k in x for k in ('path','revision','sha256')):refs.append(x)
  for v in x.values():walk(v)
 elif isinstance(x,list):
  for v in x:walk(v)
walk(new);walk(delta)
for ref in refs:assert sha(subprocess.check_output(['git','show',ref['revision']+':'+ref['path']]))==ref['sha256']
