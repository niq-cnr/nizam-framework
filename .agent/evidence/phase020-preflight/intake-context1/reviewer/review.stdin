oldspec=subprocess.check_output(['git','show',base+':'+sp]).decode();newspec=(root/sp).read_text();old=json.loads(subprocess.check_output(['git','show',base+':'+fp]));new=json.loads((root/fp).read_bytes());delta=json.loads((root/dp).read_bytes())
for k in old:
 if k not in ('spec_version','cross_phase_prerequisites','activation_prerequisites'):assert new[k]==old[k],k
