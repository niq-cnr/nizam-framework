root=Path.cwd();base='06056e9abc8290b58f47e3225f7413ac992c8d6c';revision='cef593ac195801eaedf0d04316efaf3788f8bc14';sha=lambda b:hashlib.sha256(b).hexdigest();sp='.agent/product_spec_020.md';fp='.agent/feature_list_020.json';dp='.agent/evidence/phase020-preflight/intake-current-context1.json';expected={sp:'ff9e2de8b72d3f877b346ceba52025bb44d28e6f72acda2287acd72c0320fda0',fp:'4c6e7adc494b5c362fcea016d2c58d6d23cb7d79c623ae689e58ec691461ca65',dp:'8a67ae305d9726242a1e44b1ff7e075fd6bd5fb1c76d42ef5fed6d9e8f315cdf'}
