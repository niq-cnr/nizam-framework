{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nizam.och.local/schema/external_evidence_admission.schema.json",
  "title": "Nizam Generic Optional External Evidence Admission Envelope",
  "description": "Closed machine-readable contract for optional generic external evidence admission (NF-R04). Binds protocol/profile/policy versions and digests, framework identity, consumer repository/base/candidate commit and tree, task/step/run and host-allocated attempt lineage, contract/requirement/AC bindings, frozen acceptance/regression collection digests, tool/adapter/config/isolation identity, host-authenticated producer proof, separated test/execution/admission statuses, and complete evidence descriptors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "profile_id",
    "profile_version",
    "policy_binding",
    "framework_identity",
    "consumer_binding",
    "attempt_lineage",
    "contract_binding",
    "collection_binding",
    "execution_identity",
    "producer_proof",
    "status_separation",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "protocol_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "profile_id": {
      "type": "string",
      "const": "generic-external-evidence-v1"
    },
    "profile_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "policy_binding": {
      "$ref": "#/$defs/policy_binding"
    },
    "framework_identity": {
      "$ref": "#/$defs/framework_identity"
    },
    "consumer_binding": {
      "$ref": "#/$defs/consumer_binding"
    },
    "attempt_lineage": {
      "$ref": "#/$defs/attempt_lineage"
    },
    "contract_binding": {
      "$ref": "#/$defs/contract_binding"
    },
    "collection_binding": {
      "$ref": "#/$defs/collection_binding"
    },
    "execution_identity": {
      "$ref": "#/$defs/execution_identity"
    },
    "producer_proof": {
      "$ref": "#/$defs/producer_proof"
    },
    "status_separation": {
      "$ref": "#/$defs/status_separation"
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/artifact_descriptor"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "safe_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\u0000-\\u001f\\u007f-\\u009f\\\\]+$"
    },
    "policy_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "policy_digest"
      ],
      "properties": {
        "policy_id": {
          "$ref": "#/$defs/safe_token"
        },
        "policy_version": {
          "$ref": "#/$defs/safe_token"
        },
        "policy_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "framework_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "commit_sha",
        "tree_sha"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "nizam-framework"
        },
        "version": {
          "$ref": "#/$defs/safe_token"
        },
        "commit_sha": {
          "$ref": "#/$defs/git_sha1"
        },
        "tree_sha": {
          "$ref": "#/$defs/git_sha1"
        }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "base_commit",
        "candidate_commit",
        "candidate_tree",
        "candidate_sha256"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "base_commit": {
          "$ref": "#/$defs/git_sha1"
        },
        "candidate_commit": {
          "$ref": "#/$defs/git_sha1"
        },
        "candidate_tree": {
          "$ref": "#/$defs/git_sha1"
        },
        "candidate_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "attempt_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "step_id",
        "run_id",
        "attempt_number",
        "permit_id",
        "permit_digest",
        "parent_attempt",
        "continuation_basis",
        "defect_signature",
        "operator_recovery_ref"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/safe_token"
        },
        "step_id": {
          "$ref": "#/$defs/safe_token"
        },
        "run_id": {
          "$ref": "#/$defs/safe_token"
        },
        "attempt_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "permit_id": {
          "$ref": "#/$defs/safe_token"
        },
        "permit_digest": {
          "$ref": "#/$defs/sha256"
        },
        "parent_attempt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000
        },
        "continuation_basis": {
          "type": "string",
          "enum": [
            "initial_attempt",
            "strategy_ladder",
            "bounded_amendment",
            "verified_decomposition",
            "operator_recovery"
          ]
        },
        "defect_signature": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "operator_recovery_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/relative_path"
            }
          ]
        }
      }
    },
    "contract_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "contract_digest",
        "requirement_ids",
        "acceptance_criteria_ids"
      ],
      "properties": {
        "contract_id": {
          "$ref": "#/$defs/safe_token"
        },
        "contract_digest": {
          "$ref": "#/$defs/sha256"
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safe_token"
          }
        },
        "acceptance_criteria_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safe_token"
          }
        }
      }
    },
    "collection_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptance_collection_id",
        "acceptance_collection_digest",
        "regression_collection_id",
        "regression_collection_digest"
      ],
      "properties": {
        "acceptance_collection_id": {
          "$ref": "#/$defs/safe_token"
        },
        "acceptance_collection_digest": {
          "$ref": "#/$defs/sha256"
        },
        "regression_collection_id": {
          "$ref": "#/$defs/safe_token"
        },
        "regression_collection_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "execution_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_id",
        "tool_version",
        "adapter_id",
        "adapter_version",
        "config_digest",
        "isolation_mode",
        "isolation_digest"
      ],
      "properties": {
        "tool_id": {
          "$ref": "#/$defs/safe_token"
        },
        "tool_version": {
          "$ref": "#/$defs/safe_token"
        },
        "adapter_id": {
          "$ref": "#/$defs/safe_token"
        },
        "adapter_version": {
          "$ref": "#/$defs/safe_token"
        },
        "config_digest": {
          "$ref": "#/$defs/sha256"
        },
        "isolation_mode": {
          "type": "string",
          "enum": [
            "container",
            "linux_namespace",
            "vm",
            "host_restricted"
          ]
        },
        "isolation_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "producer_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_id",
        "session_id",
        "permit_binding_digest",
        "issued_at"
      ],
      "properties": {
        "producer_id": {
          "$ref": "#/$defs/safe_token"
        },
        "session_id": {
          "$ref": "#/$defs/safe_token"
        },
        "permit_binding_digest": {
          "$ref": "#/$defs/sha256"
        },
        "issued_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      }
    },
    "status_separation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_outcome",
        "execution_status",
        "admission_decision"
      ],
      "properties": {
        "test_outcome": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "expected_negative_passed"
          ]
        },
        "execution_status": {
          "type": "string",
          "enum": [
            "completed",
            "timed_out",
            "interrupted",
            "setup_error"
          ]
        },
        "admission_decision": {
          "type": "string",
          "enum": [
            "admitted",
            "rejected",
            "quarantined"
          ]
        }
      }
    },
    "artifact_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "media_type",
        "byte_length",
        "sha256"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "stdout",
            "stderr",
            "verdict_report",
            "coverage_report",
            "trace_bundle"
          ]
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
