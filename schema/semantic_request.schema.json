{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nizam-framework:schema:semantic_request.schema.json",
  "title": "Nizam Semantic Request Schema",
  "description": "The bounded, typed request for one paid semantic dispatch: a question family/version, the full instructions with substantive context, the ordered options/rubric or polarity, the exact requested model, and the transport budget/deadline. Missing mandatory context cannot be silently omitted.",
  "type": "object",
  "required": ["schema_version", "question", "model", "transport"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "question": {
      "type": "object",
      "required": ["family", "version", "primitive", "instructions"],
      "description": "options are required for choice; polarity for noul; rubric for score",
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "primitive": { "enum": ["choice", "noul", "score"] },
        "instructions": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "polarity": { "enum": ["yes", "no"] },
        "rubric": { "type": "array", "items": { "type": "object" } }
      }
    },
    "model": {
      "type": "object",
      "required": ["requested"],
      "additionalProperties": false,
      "properties": {
        "requested": { "type": "string", "minLength": 1 }
      }
    },
    "transport": {
      "type": "object",
      "required": ["attempt_budget", "deadline"],
      "additionalProperties": false,
      "properties": {
        "attempt_budget": { "type": "integer", "minimum": 1 },
        "deadline": { "type": "string", "minLength": 1 }
      }
    }
  }
}
