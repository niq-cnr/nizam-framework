{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nizam-framework:schema:runtime_operation.schema.json",
  "title": "Runtime Operation Provenance Record",
  "description": "Closed record shape and declared invariants only; validation does not prove live runtime enforcement or source/image identity.",
  "type": "object",
  "properties": {
    "isolation": {"$ref": "#/$defs/isolation"},
    "toolchain_identity": {"$ref": "#/$defs/toolchain"},
    "lock_ref": {"type": "string", "minLength": 1},
    "core_provenance": {"$ref": "#/$defs/core"},
    "wait_outcome": {"enum": ["completed_wait", "stopped_waiting", "not_waited"]},
    "lane_authorization_ref": {"type": "string", "minLength": 1},
    "payload": {"$ref": "#/$defs/payload"},
    "context": {"$ref": "#/$defs/context"},
    "limits": {"$ref": "#/$defs/limits"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_state": {"enum": ["committed", "uncommitted"]},
    "source_manifest": {"type": "array", "items": {"$ref": "#/$defs/source_file"}, "minItems": 1},
    "command_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "external_resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}, "minItems": 0},
    "operation_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "requester": {"$ref": "#/$defs/principal"},
    "owner": {"$ref": "#/$defs/principal"},
    "expected_generation": {"$ref": "#/$defs/generation"},
    "generation": {"$ref": "#/$defs/generation"},
    "expected_lease_epoch": {"type": "integer", "minimum": 0},
    "lease_epoch": {"type": "integer", "minimum": 0},
    "contract_id": {"type": "string", "minLength": 1},
    "step_key": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["load_source", "compile_source", "evaluate", "run_tests", "observe"]},
    "status": {
      "enum": ["completed", "condition_signalled", "cancelled", "terminated", "rejected", "running", "cancel_requested", "unknown"]
    },
    "executed": {"type": "boolean"},
    "image_consistent": {"type": "boolean"},
    "evidence_class": {"const": "development"},
    "rejection_reason": {"type": "string", "minLength": 1},
    "condition_ref": {"type": "string", "minLength": 1},
    "condition_capture": {"const": "before_unwind"},
    "cancellation_confirmed": {"type": "boolean"},
    "previous_generation": {"$ref": "#/$defs/generation"},
    "previous_contract_id": {"type": "string", "minLength": 1},
    "previous_step_key": {"type": "string", "minLength": 1},
    "previous_attempt": {"type": "integer", "minimum": 1}
  },
  "required": [
    "operation_id",
    "session_id",
    "requester",
    "owner",
    "expected_generation",
    "generation",
    "expected_lease_epoch",
    "lease_epoch",
    "contract_id",
    "step_key",
    "attempt",
    "kind",
    "status",
    "executed",
    "image_consistent",
    "evidence_class"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "rejected"}}},
      "then": {"properties": {"executed": {"const": false}}, "required": ["rejection_reason"]},
      "else": {"properties": {"executed": {"const": true}}}
    },
    {
      "if": {"properties": {"status": {"const": "cancelled"}}},
      "then": {"properties": {"cancellation_confirmed": {"const": true}}, "required": ["cancellation_confirmed"]}
    },
    {
      "if": {"properties": {"wait_outcome": {"const": "stopped_waiting"}}, "required": ["wait_outcome"]},
      "then": {"properties": {"status": {"enum": ["running", "cancel_requested", "unknown"]}}}
    },
    {
      "if": {"properties": {"kind": {"enum": ["load_source", "compile_source"]}, "status": {"const": "condition_signalled"}}},
      "then": {"properties": {"image_consistent": {"const": false}}}
    },
    {
      "if": {"properties": {"requester": {"properties": {"role": {"const": "review_trial"}}, "required": ["role"]}}},
      "then": {"properties": {"executed": {"const": false}}}
    }
  ],
  "$defs": {
    "generation": {
      "type": "object",
      "properties": {"counter": {"type": "integer", "minimum": 0}, "nonce": {"type": "string", "minLength": 1}},
      "required": ["counter", "nonce"],
      "additionalProperties": false
    },
    "principal": {
      "type": "object",
      "properties": {
        "principal_kind": {"enum": ["human", "agent"]},
        "role": {"enum": ["Orchestrator", "Planner", "Generator", "Validator", "Evaluator", "review_trial"]},
        "agent_id": {"type": "string", "minLength": 1}
      },
      "required": ["principal_kind"],
      "additionalProperties": false,
      "allOf": [{"if": {"properties": {"principal_kind": {"const": "agent"}}}, "then": {"required": ["role", "agent_id"]}}]
    },
    "isolation": {
      "type": "object",
      "properties": {
        "process": {"enum": ["fresh", "retained"]},
        "build_cache": {"enum": ["fresh_private_empty", "inherited"]},
        "fixtures": {"enum": ["committed_source", "development"]},
        "configuration": {"enum": ["ignore_inherited", "inherited"]},
        "dependencies": {"enum": ["hermetic", "ambient"]},
        "resources": {"enum": ["isolated_or_reset", "shared"]}
      },
      "required": ["process", "build_cache", "fixtures", "configuration", "dependencies", "resources"],
      "additionalProperties": false
    },
    "toolchain": {
      "type": "object",
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1}
      },
      "required": ["implementation", "version"],
      "additionalProperties": false
    },
    "core": {
      "type": "object",
      "properties": {
        "kind": {"enum": ["source", "trusted_base", "development"]},
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "source_file": {
      "type": "object",
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
      "required": ["path", "sha256"],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "owner": {"$ref": "#/$defs/principal"},
        "isolation": {"enum": ["isolated", "reset", "shared"]},
        "reset_command_ref": {"type": "string", "minLength": 1}
      },
      "required": ["ref", "owner", "isolation"],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "working_dir": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "reader_config_ref": {"type": "string", "minLength": 1},
        "test_config_ref": {"type": "string", "minLength": 1}
      },
      "required": [],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {"timeout_seconds": {"type": "number", "minimum": 0}, "output_bytes": {"type": "integer", "minimum": 1}},
      "required": [],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "expression": {"type": "string", "minLength": 1},
        "test_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "observation_ref": {"type": "string", "minLength": 1}
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1
    }
  }
}
